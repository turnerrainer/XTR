<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:selftest"
    xmlns="urn:selftest" elementFormDefault="qualified">
  <xs:include schemaLocation="./types.xsd"/>
  <xs:element name="Selftest_Request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Header">
          <xs:complexType>
            <xs:attribute name="technicalId" type="ShortType" use="required"/>
            <xs:attribute name="version" type="xs:string" fixed="1"/>
            <xs:attribute name="sentOn" type="xs:date"/>
            <xs:attribute name="sentAt" type="xs:dateTime"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Body">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Item" type="ItemType" maxOccurs="3"/>
              <xs:element name="Count" type="NumType" minOccurs="0"/>
              <xs:element name="Code" type="ExactType" minOccurs="0"/>
              <xs:element name="Flag" type="FlagType" minOccurs="0"/>
              <xs:choice minOccurs="0">
                <xs:element name="Alpha" type="xs:token"/>
                <xs:element name="Beta" type="xs:string"/>
              </xs:choice>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>

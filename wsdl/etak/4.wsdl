<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:mis="http://www.maaamet.ee" xmlns:xmime="http://www.w3.org/2005/05/xmlmime" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>

  <element name="downloadFeatures">
    <complexType>
      <sequence>
        <element name="featureClass" type="string" minOccurs="1">
          <annotation>
            <appinfo>
              <xrd:title xml:lang="et">ETAK nähtusklass</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="from" type="dateTime">
          <annotation>
            <appinfo>
              <xrd:title xml:lang="et">Muutused peale antud ajatemplit, vaikimisi kõik</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="markup" default="GML">
          <annotation>
            <appinfo>
              <xrd:title>
                Millises formaadis tagastada objekti kuju geomeetria
              </xrd:title>
            </appinfo>
          </annotation>
          <simpleType>
            <restriction base="string">
              <enumeration value="GML">
                <annotation>
                  <appinfo>
                    <xrd:title>GML 3.1</xrd:title>
                  </appinfo>
                </annotation>
              </enumeration>
              <enumeration value="JSON">
                <annotation>
                  <appinfo>
                    <xrd:title>GeoJSON</xrd:title>
                  </appinfo>
                </annotation>
              </enumeration>
              <enumeration value="WKT">
                <annotation>
                  <appinfo>
                    <xrd:title>PostGIS EWKT</xrd:title>
                  </appinfo>
                </annotation>
              </enumeration>
            </restriction>
          </simpleType>
        </element>
      </sequence>
    </complexType>
  </element>

  <element name="downloadFeaturesResponse">
    <complexType>
      <sequence>
        <element name="featureClass" type="string" minOccurs="1">
          <annotation>
            <appinfo>
              <xrd:title xml:lang="et">ETAK nähtusklass</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="from" type="dateTime" minOccurs="1">
          <annotation>
            <appinfo>
              <xrd:title xml:lang="et">Muutused peale</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="to" type="dateTime" minOccurs="1">
          <annotation>
            <appinfo>
              <xrd:title xml:lang="et">Kuni ajani</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="count" type="int" minOccurs="1">
          <annotation>
            <appinfo>
              <xrd:title xml:lang="et">Kirjete arv vastusfailis</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="zipFile" type="base64Binary" xmime:expectedContentTypes="*/*">
          <annotation>
            <appinfo>
              <xrd:title xml:lang="et">Manus zip fail</xrd:title>
            </appinfo>
          </annotation>
        </element>
      </sequence>
    </complexType>
  </element>

  <complexType name="outputType">
    <annotation>
      <appinfo>
        <xrd:title xml:lang="et">Väljundfaili data.xml kirjeldus</xrd:title>
      </appinfo>
    </annotation>
    <sequence>
      <element name="featureClass">
        <annotation>
          <appinfo>
            <xrd:title xml:lang="et">Kirjete massiiv</xrd:title>
          </appinfo>
        </annotation>
        <complexType>
          <sequence>
            <element name="feature" maxOccurs="unbounded">
              <annotation>
                <appinfo>
                  <xrd:title xml:lang="et">Kirje</xrd:title>
                </appinfo>
              </annotation>
              <complexType>
                <sequence>
                  <any maxOccurs="unbounded" processContents="lax">
                    <annotation>
                      <appinfo>
                        <xrd:title xml:lang="et">Andmeväli. Väli nimega "gdb_from_date" on sündmuse ajatempel</xrd:title>
                      </appinfo>
                    </annotation>
                  </any>
                </sequence>
                <attribute name="event" use="required">
                  <annotation>
                    <appinfo>
                      <xrd:title xml:lang="et">Sündmus</xrd:title>
                    </appinfo>
                  </annotation>
                  <simpleType>
                    <restriction base="string">
                      <enumeration value="insert"/>
                      <enumeration value="update"/>
                      <enumeration value="delete"/>
                    </restriction>
                  </simpleType>
                </attribute>
              </complexType>
            </element>
          </sequence>
          <attribute name="name" use="required" type="string">
            <annotation>
              <appinfo>
                <xrd:title xml:lang="et">ETAK nähtusklass</xrd:title>
              </appinfo>
            </annotation>
          </attribute>
        </complexType>
      </element>
    </sequence>
  </complexType>

</schema>
      
</wsdl:types>
    <wsdl:message name="requestHeader">
        <wsdl:part name="client" element="xrd:client"/>
        <wsdl:part name="service" element="xrd:service"/>
        <wsdl:part name="id" element="xrd:id"/>
        <wsdl:part name="userId" element="xrd:userId"/>
        <wsdl:part name="issue" element="xrd:issue"/>
        <wsdl:part name="protocolVersion" element="xrd:protocolVersion"/>
    </wsdl:message>
    <wsdl:message name="downloadFeatures">
        <wsdl:part name="body" element="tns:downloadFeatures"/>
    </wsdl:message>
    <wsdl:message name="downloadFeaturesResponse">
        <wsdl:part name="body" element="tns:downloadFeaturesResponse"/>
    </wsdl:message>
    <wsdl:portType name="servicePortType">
        <wsdl:operation name="downloadFeatures">
          <wsdl:documentation>
            <xrd:title xml:lang="et">ETAK andmed  </xrd:title>
          </wsdl:documentation>
          <wsdl:input message="tns:downloadFeatures"/>
            <wsdl:output message="tns:downloadFeaturesResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="serviceBinding" type="tns:servicePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="downloadFeatures">
            <soap:operation soapAction="" style="document"/>
            <xrd:version>v1</xrd:version>
            <wsdl:input>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="xroadeuService">
        <wsdl:port binding="tns:serviceBinding" name="xroadeuServicePort">
            <soap:address location="http://example.org/xroad-endpoint"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:maa="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
  <include schemaLocation="http://www.maaamet.ee/schemas/xtee6/maa_typesv6.xsd"/>
  <include schemaLocation="http://www.maaamet.ee/schemas/xtee6/maa_klassifikaatoridv6.xsd"/>
  <element name="ehaklogikompl" type="maa:ehaklogikomplParingType"/>
  <element name="ehaklogikomplResponse" type="maa:ehaklogikomplVastusType"/>
  <complexType name="ehaklogikomplParingType">
    <annotation>
      <appinfo>
        <xrd:title>EHAK muudatuskomplektid</xrd:title>
      </appinfo>
    </annotation>
    <sequence>
      <element name="algkuupaev" type="date" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Kuupäev, millest alates muudatused tagastatakse</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="loppkuupaev" type="date" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Millise kuupäevani</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="piirkond" type="maa:ehakkoodType" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Piirkond (EHAK kood)</xrd:title>
            <xrd:notes>Sisesta neljakohaline EHAK kood nt 0070</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="mis_andmed" type="maa:vektor2Type" default="10">
        <annotation>
          <appinfo>
            <xrd:title>Milliseid andmeid näha soovitakse</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="max_arv" type="int" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Maksimaalne tagastavate kirjete arv</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="alates_logiID" type="int" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Alates logi ID-st</xrd:title>
            <xrd:notes>Logi ID-d järjehoidjana kasutamisel peavad ülejäänud päringutingimused samaks jääma</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="ruumiAndmeteFormaat" type="maa:kujuGeomeetriaFormaatType" minOccurs="0" default="GML">
        <annotation>
          <appinfo>
            <xrd:title>
              Millises formaadis tagastada objekti kuju geomeetria
            </xrd:title>
          </appinfo>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <complexType name="ehaklogikomplVastusType">
    <sequence>
      <element name="logijarg" type="int" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Järgmise päringu alguse logi id</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="tulem" minOccurs="0">
        <complexType>
          <sequence>
            <element name="ehakandmed" maxOccurs="unbounded">
              <annotation>
                <documentation>EHAK andmed</documentation>
              </annotation>
              <complexType>
                <sequence>
                  <element name="syndmus" type="maa:syndmusType">
                    <annotation>
                      <appinfo>
                        <xrd:title>Muudatuse iseloom</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="nimi" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>EHAK nimetus</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="ehaktyyp" type="maa:EhaktyypKlassifikaator" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>EHAK objekti tüüp</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="ehakkood" type="maa:ehakkoodType" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>EHAK objekti kood</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="vallaKood" type="maa:ehakkoodType" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Omavalitsuse kood</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="vallaNimi" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Omavalitsuse nimi</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="mkKood" type="maa:ehakkoodType" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Maakonna kood</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="mkNimi" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Maakonna nimi</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="pindala" type="decimal" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Pindala (m2)</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="vastuvotmiseAeg" type="date" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Õigusliku aluse vastuvõtmise aeg</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="juriidilineAlus" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Õiguslik alus</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="juriidKehtimisalgusAeg" type="date" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Õiguslik kehtivuse algus</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="juriidKehtivuseLopp" type="date" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Õiguslik kehtivuse lõpp</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="muudatusePohjus" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Muudatuse põhjus</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="allkirjastatud" type="dateTime" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Allkirjastamise kuupäev</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="tsentroid" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Tsentroidi x,y koordinaadid</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="veelmuutusi" type="maa:JahEiType" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Kas objektil on hilisemaid muudatusi</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="kuju" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>EHAK objekti ruumiandmed</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                </sequence>
              </complexType>
            </element>
          </sequence>
        </complexType>
      </element>
      <element name="fault" minOccurs="0">
        <complexType>
          <sequence>
            <element name="faultCode" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kood</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="faultString" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kirjeldus</xrd:title>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
    </sequence>
  </complexType>
  <simpleType name="JahEiType">
    <annotation>
      <appinfo>
        <xrd:title>Jah/Ei vastus</xrd:title>
      </appinfo>
    </annotation>
    <restriction base="string">
      <enumeration value="0">
        <annotation>
          <appinfo>
            <xrd:title>Ei</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="1">
        <annotation>
          <appinfo>
            <xrd:title>Jah</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
    </restriction>
  </simpleType>
  <simpleType name="syndmusType">
    <restriction base="string">
      <enumeration value="I">
        <annotation>
          <appinfo>
            <xrd:title>Lisandunud</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="U">
        <annotation>
          <appinfo>
            <xrd:title>Muutunud</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="D">
        <annotation>
          <appinfo>
            <xrd:title>Sulgunud</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
    </restriction>
  </simpleType>
</schema>

        <wsdl:part name="body" element="tns:ehaklogikomplResponse"/>
    </wsdl:message>
    <wsdl:portType name="servicePortType">
        <wsdl:operation name="ehaklogikompl">
          <wsdl:documentation>
            <xrd:title xml:lang="et">EHAK muudatuskomplektid</xrd:title>
          </wsdl:documentation>
          <wsdl:input message="tns:ehaklogikompl"/>
            <wsdl:output message="tns:ehaklogikomplResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="serviceBinding" type="tns:servicePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="ehaklogikompl">
            <soap:operation soapAction="" style="document"/>
            <xrd:version>v1</xrd:version>

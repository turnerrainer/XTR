<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:maa="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
  <element name="kpo_lk_mk_logi" type="maa:kpo_lk_mk_logiParingType">
    <annotation>
      <appinfo>
        <xrd:title>KPO-is tehtud analüüside muudatuste logi</xrd:title>
      </appinfo>
    </annotation>
  </element>
  <element name="kpo_lk_mk_logiResponse" type="maa:kpo_lk_mk_logiVastusType"/>
  <complexType name="kpo_lk_mk_logiParingType">
    <annotation>
      <appinfo>
        <xrd:title>KPO-is tehtud analüüside muudatuste logi</xrd:title>
      </appinfo>
    </annotation>
    <sequence>
      <choice>
        <element name="log_id" type="integer">
          <annotation>
            <appinfo>
              <xrd:title>Logi ID</xrd:title>
              <xrd:notes>Alatest mitmendast logi kirjest päritakse</xrd:notes>
            </appinfo>
            <documentation>Alatest mitmendast logi kirjest päritakse</documentation>
          </annotation>
        </element>
        <element name="algus" type="dateTime">
          <annotation>
            <appinfo>
              <xrd:title>Muudatuse algus</xrd:title>
              <xrd:notes>Päritavate muudatuste alguskuupäev-kellaaeg (kujul: yyyy-mm-ddThh:min:ss)</xrd:notes>
            </appinfo>
            <documentation>Päritavate muudatuste alguskuupäev-kellaaeg (kujul: yyyy-mm-ddThh:min:ss)</documentation>
          </annotation>
        </element>
      </choice>
      <element name="lopp" type="dateTime" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Muudatuse lõpp</xrd:title>
            <xrd:notes>Päritavate muudatuste lõppkuupäev-kellaaeg (kujul: yyyy-mm-ddThh:min:ss)</xrd:notes>
          </appinfo>
          <documentation>Päritavate muudatuste lõppkuupäev-kellaaeg (kujul: yyyy-mm-ddThh:min:ss)</documentation>
        </annotation>
      </element>
      <element name="paringuvektor" default="111">
        <annotation>
          <appinfo>
            <xrd:title>Päringuvektor</xrd:title>
            <xrd:notes>Kolme sümboli pikkune tekst. Esimene koht näitab kirjete lisamist (1 või 0), teine koht kirjete muutmist(1 või 0) ning kolmas koht näitab kirjete kustutamist(1 või 0).</xrd:notes>
          </appinfo>
          <documentation>Pärnguvektor</documentation>
        </annotation>
        <simpleType>
          <restriction base="normalizedString">
            <pattern value="[0-1]{3}"/>
          </restriction>
        </simpleType>
      </element>
      <element name="max_kirjeid" default="1000">
        <annotation>
          <appinfo>
            <xrd:title>Max kirjete arv</xrd:title>
            <xrd:notes>Maksimaalselt tagastavate kirjete arv ühe päringuga (vaikimisi 1000)</xrd:notes>
          </appinfo>
          <documentation>Maksimaalselt tagastavate kirjete arv ühe päringuga (vaikimisi 1000)</documentation>
        </annotation>
        <simpleType>
          <restriction base="integer">
            <minExclusive value="1"/>
          </restriction>
        </simpleType>
      </element>
    </sequence>
  </complexType>
  <complexType name="kpo_lk_mk_logiVastusType">
    <annotation>
      <appinfo>
        <xrd:title>KPO-is tehtud analüüside muudatuste logi</xrd:title>
      </appinfo>
    </annotation>
    <sequence>
      <element name="logi" minOccurs="0" maxOccurs="unbounded">
        <complexType>
          <sequence>
            <element name="id" type="integer">
              <annotation>
                <appinfo>
                  <xrd:title>Id</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="muudatus" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Muudatus</xrd:title>
                  <xrd:notes>Muudatuste operatsiooni kood: I - insert, U - update, D -delete</xrd:notes>
                </appinfo>
                <documentation>Muudatuste operatsiooni kood: I - insert, U - update, D -delete</documentation>
              </annotation>
            </element>
            <element name="stamp" type="dateTime">
              <annotation>
                <appinfo>
                  <xrd:title>Stamp</xrd:title>
                  <xrd:notes>kirje lisamise, muutmise või kustutamise aeg</xrd:notes>
                </appinfo>
                <documentation>kirje lisamise, muutmise või kustutamise aeg</documentation>
              </annotation>
            </element>
            <element name="lk_kpo_id" type="integer">
              <annotation>
                <appinfo>
                  <xrd:title>Lk Kpo Id</xrd:title>
                  <xrd:notes>Looduskaitseobjekti KPO globaalne ID</xrd:notes>
                </appinfo>
                <documentation>Looduskaitseobjekti KPO globaalne ID</documentation>
              </annotation>
            </element>
            <element name="mk_kpo_id" type="integer">
              <annotation>
                <appinfo>
                  <xrd:title>Mk Kpo Id</xrd:title>
                  <xrd:notes>Muinsuskaitseobjekti KPO globaalne ID</xrd:notes>
                </appinfo>
                <documentation>Muinsuskaitseobjekti KPO globaalne ID</documentation>
              </annotation>
            </element>
            <element name="lk_piirang_liik" type="integer">
              <annotation>
                <appinfo>
                  <xrd:title>LK piirangu liik</xrd:title>
                  <xrd:notes>1 - Looduskaitse punktobjekt, 2 - Looduskaitse alaobjekt, 3 - Looduskaitse piiranguvöönd</xrd:notes>
                </appinfo>
                <documentation>1 - Looduskaitse punktobjekt, 2 - Looduskaitse alaobjekt, 3 - Looduskaitse piiranguvöönd</documentation>
              </annotation>
            </element>
            <element name="mk_piirang_liik" type="integer">
              <annotation>
                <appinfo>
                  <xrd:title>MK piirangu liik</xrd:title>
                  <xrd:notes>1 - Muinsuskaitse punktobjekt, 2 - Muinsuskaitseala, 3 - Muinsuskaitse piiranguvöönd</xrd:notes>
                </appinfo>
                <documentation>1 - Muinsuskaitse punktobjekt, 2 - Muinsuskaitseala, 3 - Muinsuskaitse piiranguvöönd</documentation>
              </annotation>
            </element>
            <element name="mk_registrinumber" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>MK reg.nr</xrd:title>
                  <xrd:notes>Muinsuskaitseobjekti või piiranguvööndi registrinumber</xrd:notes>
                </appinfo>
                <documentation>Muinsuskaitseobjekti või piiranguvööndi registrinumber</documentation>
              </annotation>
            </element>
            <element name="mk_nimi" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>MK nimi</xrd:title>
                  <xrd:notes>Muinsuskaitseobjekti nimi</xrd:notes>
                </appinfo>
                <documentation>Muinsuskaitseobjekti nimi</documentation>
              </annotation>
            </element>
            <element name="lk_nimi" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>LK nimi</xrd:title>
                  <xrd:notes>Looduskaitse ala- ja punktobjektide nimi</xrd:notes>
                </appinfo>
                <documentation>Looduskaitse ala- ja punktobjektide nimi</documentation>
              </annotation>
            </element>
            <element name="lk_eelis_id" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>LK EELIS</xrd:title>
                  <xrd:notes>Looduskaitse objekti või piiranguvööndi EELIS kood</xrd:notes>
                </appinfo>
                <documentation>Looduskaitse objekti või piiranguvööndi EELIS kood</documentation>
              </annotation>
            </element>
            <element name="lk_pv_nimi" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>LK PV nimi</xrd:title>
                  <xrd:notes>Looduskaitse piiranguvööndi nimi</xrd:notes>
                </appinfo>
                <documentation>Looduskaitse piiranguvööndi nimi</documentation>
              </annotation>
            </element>
            <element name="lk_ruumiseos" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>LK ruumiseos</xrd:title>
                  <xrd:notes>Oracle ruumiseosed</xrd:notes>
                </appinfo>
              </annotation>
            </element>
            <element name="mk_ruumiseos" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>MK ruumiseos</xrd:title>
                  <xrd:notes>Oracle ruumiseosed</xrd:notes>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
      <element name="fault" minOccurs="0">
        <complexType>
          <sequence>
            <element name="faultCode" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kood</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="faultString" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kirjeldus</xrd:title>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
    </sequence>
  </complexType>
</schema>

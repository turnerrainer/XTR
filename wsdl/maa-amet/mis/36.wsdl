<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:maa="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
  <element name="tehingud" type="maa:tehingudParingType">
    <annotation>
      <appinfo>
        <xrd:title>Tehingute andmed kinnisasja tehingute jaoks Notariaalregistrist</xrd:title>
      </appinfo>
    </annotation>
  </element>
  <element name="tehingudResponse" type="maa:tehingudVastusType"/>
  <complexType name="tehingudParingType">
    <annotation>
      <appinfo>
        <xrd:title>Tehingud</xrd:title>
      </appinfo>
    </annotation>
    <sequence minOccurs="1" maxOccurs="unbounded">
      <element name="tehing">
        <complexType>
          <sequence>
            <element name="tehinguNR">
              <annotation>
                <appinfo>
                  <xrd:title>Tehingu number</xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="normalizedString">
                  <minLength value="1"/>
                  <maxLength value="12"/>
                </restriction>
              </simpleType>
            </element>
            <element name="summa" type="nonNegativeInteger">
              <annotation>
                <appinfo>
                  <xrd:title>Summa</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="tunnused" type="token">
              <annotation>
                <appinfo>
                  <xrd:title>Tunnused</xrd:title>
                  <xrd:notes>Katastritunnuste või kinnistu numbrite loetelu vastavas formaadis
                  </xrd:notes>
                </appinfo>
              </annotation>
            </element>
            <element name="omandiosa" type="positiveInteger">
              <annotation>
                <appinfo>
                  <xrd:title>Omandiosa</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="osadest" type="positiveInteger">
              <annotation>
                <appinfo>
                  <xrd:title>Omandiosadest</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="kuupaev" type="date">
              <annotation>
                <appinfo>
                  <xrd:title>Kuupäev</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="objektiLiik">
              <annotation>
                <appinfo>
                  <xrd:title>Objekti liik</xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="string">
                  <enumeration value="HOIG">
                    <annotation>
                      <appinfo>
                        <xrd:title>Hoonestusõigus</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="KASI">
                    <annotation>
                      <appinfo>
                        <xrd:title>Kinnisasi</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="KHOI">
                    <annotation>
                      <appinfo>
                        <xrd:title>Korteri hoonestusõigus</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="KOM">
                    <annotation>
                      <appinfo>
                        <xrd:title>Korteriomand</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="KVAL">
                    <annotation>
                      <appinfo>
                        <xrd:title>Kasutusvaldus</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="MUUO">
                    <annotation>
                      <appinfo>
                        <xrd:title>Muu objekt</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                </restriction>
              </simpleType>
            </element>
            <element name="tehinguLiik">
              <annotation>
                <appinfo>
                  <xrd:title>Tehingu liik</xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="string">
                  <enumeration value="KINK">
                    <annotation>
                      <appinfo>
                        <xrd:title>Kinkimine</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="MUUT">
                    <annotation>
                      <appinfo>
                        <xrd:title>Muu tehing</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="OSTM">
                    <annotation>
                      <appinfo>
                        <xrd:title>Ost-müük</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="PARI">
                    <annotation>
                      <appinfo>
                        <xrd:title>Pärimine</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="VAHE">
                    <annotation>
                      <appinfo>
                        <xrd:title>Vahetus</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                </restriction>
              </simpleType>
            </element>
            <element name="hoonestatud">
              <annotation>
                <appinfo>
                  <xrd:title>Hoonestatud</xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="string">
                  <enumeration value="J">
                    <annotation>
                      <appinfo>
                        <xrd:title>Jah</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="E">
                    <annotation>
                      <appinfo>
                        <xrd:title>Ei</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                </restriction>
              </simpleType>
            </element>
            <element name="sisaldabKm" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Sisaldab käibemaksu</xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="string">
                  <enumeration value="J">
                    <annotation>
                      <appinfo>
                        <xrd:title>Jah</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="E">
                    <annotation>
                      <appinfo>
                        <xrd:title>Ei</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                </restriction>
              </simpleType>
            </element>
            <element name="notar" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Notari isikukood</xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="normalizedString">
                  <minLength value="11"/>
                  <maxLength value="11"/>
                </restriction>
              </simpleType>
            </element>
            <element name="residentinfo">
              <complexType>
                <sequence>
                  <element name="residendid" type="maa:residentType" minOccurs="1" maxOccurs="unbounded">
                    <annotation>
                      <appinfo>
                        <xrd:title>Residendid</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                </sequence>
              </complexType>
            </element>
            <element name="notariMarkus" type="string" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Notari märkus</xrd:title>
                </appinfo>
              </annotation>
            </element>

            <element name="lepinguLiik">
              <annotation>
                <appinfo>
                  <xrd:title>Lepingu liik</xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="string">
                  <enumeration value="VÕL">
                    <annotation>
                      <appinfo>
                        <xrd:title>Võlaõigusleping</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="AÕL">
                    <annotation>
                      <appinfo>
                        <xrd:title>Asjaõigusleping</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                  <enumeration value="VÕL+AÕL">
                    <annotation>
                      <appinfo>
                        <xrd:title>Samas lepingus võla- ja asjaõigus</xrd:title>
                      </appinfo>
                    </annotation>
                  </enumeration>
                </restriction>
              </simpleType>
            </element>
            <element name="volLepinguNotar" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Võlaõiguslepingu sõlminud notari isikukood. Täidetakse ainult siis, kui
                    lepingu liik on AÕL
                  </xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="normalizedString">
                  <minLength value="11"/>
                  <maxLength value="11"/>
                </restriction>
              </simpleType>
            </element>
            <element name="volTehinguNR" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Võlaõiguslepingu tehingu number (ilma järjenumbrita). Täidetakse ainult
                    siis, kui lepingu liik on AÕL
                  </xrd:title>
                </appinfo>
              </annotation>
              <simpleType>
                <restriction base="normalizedString">
                  <minLength value="1"/>
                  <maxLength value="12"/>
                </restriction>
              </simpleType>
            </element>
            <element name="volKuupaev" type="date" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Võlaõiguslepingu kuupäev. Täidetakse ainult siis, kui lepingu liik on
                    AÕL
                  </xrd:title>
                </appinfo>
              </annotation>
            </element>

          </sequence>
        </complexType>
      </element>
    </sequence>
  </complexType>
  <complexType name="tehingudVastusType">
    <sequence>
      <element name="salvestamiseTulem" minOccurs="0" maxOccurs="unbounded">
        <complexType>
          <sequence>
            <element name="tehinguNR" type="normalizedString">
              <annotation>
                <appinfo>
                  <xrd:title>Tehingu number</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="viga" type="string" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Veatekst</xrd:title>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
      <element name="fault" minOccurs="0">
        <complexType>
          <sequence>
            <element name="faultCode" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kood</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="faultString" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kirjeldus</xrd:title>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
    </sequence>
  </complexType>
  <complexType name="residentType">
    <sequence>
      <element name="tunnus">
        <annotation>
          <appinfo>
            <xrd:title>Tunnus</xrd:title>
          </appinfo>

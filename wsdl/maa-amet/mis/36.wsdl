              </annotation>
            </enumeration>
            <enumeration value="M">
              <annotation>
                <appinfo>
                  <xrd:title>M</xrd:title>
                </appinfo>
              </annotation>
            </enumeration>
          </restriction>
        </simpleType>
      </element>
      <element name="isikuLiik" type="maa:isikudType">
        <annotation>
          <appinfo>
            <xrd:title>Isiku liik</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="riik">
        <annotation>
          <appinfo>
            <xrd:title>Riik</xrd:title>
          </appinfo>
        </annotation>
        <simpleType>
          <restriction base="normalizedString">
            <length value="3"/>
          </restriction>
        </simpleType>
      </element>
      <element name="osakaalLugeja" type="positiveInteger">
        <annotation>
          <appinfo>
            <xrd:title>Osakaal (lugeja)</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="osakaalNimetaja" type="positiveInteger">
        <annotation>
          <appinfo>
            <xrd:title>Osakaal (nimetaja)</xrd:title>
          </appinfo>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <simpleType name="isikudType">
    <annotation>
      <documentation>Isiku tüüpide loend</documentation>
    </annotation>
    <restriction base="string">
      <enumeration value="EI">
        <annotation>
          <appinfo>
            <xrd:title>EI</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="EJ">
        <annotation>
          <appinfo>
            <xrd:title>EJ</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="AJ">
        <annotation>
          <appinfo>
            <xrd:title>AJ</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="KO">
        <annotation>
          <appinfo>
            <xrd:title>KO</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="RK">
        <annotation>
          <appinfo>
            <xrd:title>RK</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="VM">
        <annotation>
          <appinfo>
            <xrd:title>VM</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="VR">
        <annotation>
          <appinfo>
            <xrd:title>VR</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="VA">
        <annotation>
          <appinfo>
            <xrd:title>VA</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="MU">
        <annotation>
          <appinfo>
            <xrd:title>MU</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
    </restriction>
  </simpleType>
</schema>

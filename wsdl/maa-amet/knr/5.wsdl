<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:knr="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">

	<import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
	<include schemaLocation="http://www.maaamet.ee/schemas/xtee6/kohaNimiv6_types.xsd"/>

	<element name="kohanimedeParing" type="knr:kohanimedeParingRequestType">
		<annotation>
			<appinfo>
				<xrd:title>Kohanimede päring tekstiliste atribuutide ja ruumifiltri
					põhjal</xrd:title>
			</appinfo>
		</annotation>
	</element>

	<element name="kohanimedeParingResponse" type="knr:kohanimedeParingResponseType"/>

	<complexType name="kohanimedeParingRequestType">
		<sequence>
			<element name="kohaNimi" type="string" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:notes>
							Tähekombinatsioon, mida antud kohanimi peab sisaldama.
							Lisavõimalusena on võimalik
							valida, kas tähekombinatsiooni
							otsitakse nime algusest, keskelt
							või lõpust.
						</xrd:notes>
						<xrd:title>Kohanimi või tekstiosa</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="kohaNimiMeetod" type="knr:kohaNimiMeetodType" default="0">
				<annotation>
					<appinfo>
						<xrd:notes>
							Kohanimi või tekstiosa otsingu meetod kas täpne,
							algusest, lõpust,
							keskelt
						</xrd:notes>
						<xrd:title>Otsingu meetod</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="kohaNimiStaatus" type="knr:kohaNimiStaatusType" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:notes>
							Ametlikud on kohanimed, mis on määratud õigusaktiga.
						</xrd:notes>
						<xrd:title>Kohanime staatus</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="kohaNimiKeel" type="knr:knrkeelKlassifikaator" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:notes>Mis keeles kohanime soovite</xrd:notes>
						<xrd:title>Kohanime keel</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="kohaNimiObjLiik" type="knr:knrnimeobjliikKlassifikaator" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:title>Kohanime nimeobjekti liik</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="maakond" type="knr:ehak" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:title>Maakond</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="omavalitsus" type="knr:ehak" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:ref>maakond</xrd:ref>
						<xrd:title>Omavalitsus</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="asustusyksus" type="knr:ehak" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:ref>omavalitsus</xrd:ref>
						<xrd:title>Asustusüksus</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="regAeg" type="date" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:notes>
							Selle menetluse jõustamise kuupäev, millega kohanimi
							registrisse
							tekkis
						</xrd:notes>
						<xrd:title>Kohanime registreerimise aeg</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="muudatuseKp" type="date" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:notes>
							Kohanime alusdokumendi või allikmaterjali jõustumise,
							selle puudumisel
							väljaandmise kuupäev
						</xrd:notes>
						<xrd:title>Kohanime õigusliku aluse kuupäev</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="maxVastuseid" type="integer" default="100"/>
			<choice minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:title>Ruumifilter</xrd:title>
					</appinfo>
				</annotation>
				<sequence>
					<annotation>
						<appinfo>
							<xrd:title>Punkti koordinaadid</xrd:title>
						</appinfo>
					</annotation>
					<element name="punktXkoord" type="decimal">
						<annotation>
							<appinfo>
								<xrd:title>Punkti x-koordinaat(6 300 000 - 6 700 000)
								</xrd:title>
							</appinfo>
						</annotation>
					</element>
					<element name="punktYkoord" type="decimal">
						<annotation>
							<appinfo>
								<xrd:title>Punkti y-koordinaat(300 000 - 800 000)</xrd:title>
							</appinfo>
						</annotation>
					</element>
					<element name="punktRaadius" type="decimal">
						<annotation>
							<appinfo>
								<xrd:title>Raadius (m)</xrd:title>
							</appinfo>
						</annotation>
					</element>
				</sequence>
				<sequence>
					<annotation>
						<appinfo>
							<xrd:title>Ruumiala koordinaadid</xrd:title>
						</appinfo>
					</annotation>
					<element name="geofenceX1koord" type="decimal">
						<annotation>
							<appinfo>
								<xrd:title>Ruumiakna x-koordinaat(Xmin)</xrd:title>
							</appinfo>
						</annotation>
					</element>
					<element name="geofenceY1koord" type="decimal">
						<annotation>
							<appinfo>
								<xrd:title>Ruumiakna y-koordinaat(Ymin)</xrd:title>
							</appinfo>
						</annotation>
					</element>
					<element name="geofenceX2koord" type="decimal">
						<annotation>
							<appinfo>
								<xrd:title>Ruumiakna x-koordinaat(Xmax)</xrd:title>
							</appinfo>
						</annotation>
					</element>
					<element name="geofenceY2koord" type="decimal">
						<annotation>
							<appinfo>
								<xrd:title>Ruumiakna y-koordinaat(Ymax)</xrd:title>
							</appinfo>
						</annotation>
					</element>
				</sequence>
			</choice>
		</sequence>
	</complexType>
	<complexType name="kohanimedeParingResponseType">
		<sequence minOccurs="0" maxOccurs="unbounded">
			<element name="tulem">
				<complexType>
					<sequence>
						<element name="KOHANIME_ID" type="integer">
							<annotation>
								<appinfo>
									<xrd:title>Kohanime identifikaator</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="NIMEOBJEKTI_ID" type="integer">
							<annotation>
								<appinfo>
									<xrd:title>Nimeobjekti identifikaator</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="KOHANIMI" type="normalizedString">
							<annotation>
								<appinfo>
									<xrd:title>Kohanimi</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="KEEL" type="knr:knrkeelKlassifikaator">
							<annotation>
								<appinfo>
									<xrd:title>Keel</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="STAATUS" type="knr:kohaNimiStaatusType">
							<annotation>
								<appinfo>
									<xrd:title>Staatus</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="KEHTIVUS" type="knr:kohaNimiOlekType">
							<annotation>
								<appinfo>
									<xrd:title>Kehtivus</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="NIMEOBJEKTI_LIIGI_KOOD" type="knr:knrnimeobjliikKlassifikaator">
							<annotation>
								<appinfo>
									<xrd:title>Nimeobjekti liik</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="MAAKOND" type="knr:ehak">
							<annotation>
								<appinfo>
									<xrd:title>Maakond</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="OMAVALITSUS" type="knr:ehak">
							<annotation>
								<appinfo>
									<xrd:title>Omavalitsus</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="ASUSTUSYKSUS" type="knr:ehak">
							<annotation>
								<appinfo>
									<xrd:title>Asustusüksus</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="TAISAADRESS" type="normalizedString">
							<annotation>
								<appinfo>
									<xrd:title>Objekti täisaadress</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="PUNKT_X" type="decimal" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Tunnuspunkti x-koordinaat</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="PUNKT_Y" type="decimal" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Tunnuspunkti y-koordinaat</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="JOUSTUMISE_KUUPAEV" type="date">
							<annotation>
								<appinfo>
									<xrd:title>Jõustumise kuupäev</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="TUHISTAMISE_KUUPAEV" type="date">
							<annotation>
								<appinfo>
									<xrd:title>Tühistamise kuupäev</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="DOK_NIMETUS" type="normalizedString">
							<annotation>
								<appinfo>
									<xrd:title>Alusdokumendi nimetus</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="DOK_KUUPAEV" type="date">
							<annotation>
								<appinfo>
									<xrd:title>Alusdokumendi kehtivuse algus</xrd:title>
								</appinfo>
							</annotation>
						</element>
					</sequence>
					<attribute name="id" type="ID">
						<annotation>
							<appinfo>
								<xrd:title>Päringu kirje unikaalne identifikaator</xrd:title>
							</appinfo>
						</annotation>
					</attribute>
				</complexType>
			</element>
		</sequence>
	</complexType>

</schema>
</wsdl:types>
    <wsdl:message name="requestHeader">
        <wsdl:part name="client" element="xrd:client"/>
        <wsdl:part name="service" element="xrd:service"/>
        <wsdl:part name="id" element="xrd:id"/>
        <wsdl:part name="userId" element="xrd:userId"/>
        <wsdl:part name="issue" element="xrd:issue"/>
        <wsdl:part name="protocolVersion" element="xrd:protocolVersion"/>
    </wsdl:message>
    <wsdl:message name="kohanimedeParing">
        <wsdl:part name="body" element="tns:kohanimedeParing"/>
    </wsdl:message>
    <wsdl:message name="kohanimedeParingResponse">
        <wsdl:part name="body" element="tns:kohanimedeParingResponse"/>
    </wsdl:message>
    <wsdl:portType name="servicePortType">
        <wsdl:operation name="kohanimedeParing">
          <wsdl:documentation>
            <xrd:title xml:lang="et">Kohanimede päring tekstiliste atribuutide ja ruumifiltri põhjal</xrd:title>
          </wsdl:documentation>
          <wsdl:input message="tns:kohanimedeParing"/>
            <wsdl:output message="tns:kohanimedeParingResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="serviceBinding" type="tns:servicePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="kohanimedeParing">
            <soap:operation soapAction="" style="document"/>
            <xrd:version>v1</xrd:version>
            <wsdl:input>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="xroadeuService">
        <wsdl:port binding="tns:serviceBinding" name="xroadeuServicePort">
            <soap:address location="http://example.org/xroad-endpoint"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
              </element>
              <element name="vanaAdrId" type="integer" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadressi eelmise versiooni number muutmise korral</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="vanaTaisAadress" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadressi eelmine täielik nimekuju muutmise korral</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="vanaLahiAadress" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Eelmine lähiaadress muutmise korral</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="esindusPunktX" type="double" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadressi esinduspunkti x-koordinaat</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="esindusPunktY" type="double" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadressi esinduspunkti y-koordinaat</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="eellased" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadressi võimalikeks eellasteks olevate aadresside ADR_ID väärtuste loetelu</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="jarglased" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadressi võimalikeks järglaseks olevate aadresside ADR_ID väärtuste loetelu</xrd:title>
                    <xrd:notes>Järglased on võimalikud ainult tühistatud komponentide korral</xrd:notes>
                  </appinfo>
                </annotation>
              </element>
              <element name="poleSeotud" type="boolean">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadress on kehtetu ja ta pole seotud ühegi kehtiva objektiga</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="objektiLiik" type="ads:adsobjliikKlassifikaator" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Objekti liigi nimi klassifikaatorist</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adsOid" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Objekti ADS süsteemi kood</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adobId" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Objekti versioonitunnus ADS süsteemis</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="origTunnus" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Objekti tunnus originaalregistris</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="punktX" type="double" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Objekti tsentroidipunkti x-koordinaat</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="punktY" type="double" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Objekti tsentroidipunkti y-koordinaat</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="liidestujaObjektid" minOccurs="0">
                <complexType>
                  <sequence>
                    <element name="liidestujaObjekt" maxOccurs="unbounded">
                      <complexType>
                        <sequence>
                          <element name="register" type="ads:adsRegisterType" minOccurs="0">
                            <annotation>
                              <appinfo>
                                <xrd:title>Register</xrd:title>
                              </appinfo>
                            </annotation>
                          </element>
                          <element name="idRegistris" type="string" minOccurs="0">
                            <annotation>
                              <appinfo>
                                <xrd:title>Objekti tunnus liidestuja juures</xrd:title>
                                <xrd:notes>vastavalt kas korteriomandi number või äriregistri registrikood</xrd:notes>
                              </appinfo>
                            </annotation>
                          </element>
                          <element name="lisainfo" type="string" minOccurs="0">
                            <annotation>
                              <appinfo>
                                <xrd:title>Eriomandi number korteriomandi puhul või juriidilise isiku nimi</xrd:title>
                              </appinfo>
                            </annotation>
                          </element>
                        </sequence>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
              <element name="adrSeosed" minOccurs="0">
                <complexType>
                  <sequence>
                    <element name="adrSeos" minOccurs="0" maxOccurs="unbounded">
                      <complexType>
                        <sequence>
                          <element name="objektiLiik" type="ads:adsobjliikKlassifikaator">
                            <annotation>
                              <appinfo>
                                <xrd:title>Objekti liigi nimi klassifikaatorist</xrd:title>
                              </appinfo>
                            </annotation>
                          </element>
                          <element name="adsOid" type="string">
                            <annotation>
                              <appinfo>
                                <xrd:title>Objekti ADS süsteemi kood</xrd:title>
                              </appinfo>
                            </annotation>
                          </element>
                          <element name="adobId" type="string">
                            <annotation>
                              <appinfo>
                                <xrd:title>Objekti versioonitunnus ADS süsteemis</xrd:title>
                              </appinfo>
                            </annotation>
                          </element>
                          <element name="origTunnus" type="string" minOccurs="0">
                            <annotation>
                              <appinfo>
                                <xrd:title>Objekti tunnus originaalregistris</xrd:title>
                              </appinfo>
                            </annotation>
                          </element>
                          <element name="unikaalne" type="boolean" minOccurs="0">
                            <annotation>
                              <appinfo>
                                <xrd:title>Objekt on unikaalaadressi tunnusega</xrd:title>
                              </appinfo>
                            </annotation>
                          </element>
                          <element name="liidestujaObjektid" minOccurs="0">
                            <complexType>
                              <sequence>
                                <element name="liidestujaObjekt" maxOccurs="unbounded">
                                  <complexType>
                                    <sequence>
                                      <element name="register" type="ads:adsRegisterType" minOccurs="0">
                                        <annotation>
                                          <appinfo>
                                            <xrd:title>Register</xrd:title>
                                          </appinfo>
                                        </annotation>
                                      </element>
                                      <element name="idRegistris" type="string" minOccurs="0">
                                        <annotation>
                                          <appinfo>
                                            <xrd:title>Objekti tunnus liidestuja juures</xrd:title>
                                            <xrd:notes>vastavalt kas korteriomandi number või äriregistri registrikood</xrd:notes>
                                          </appinfo>
                                        </annotation>
                                      </element>
                                      <element name="lisainfo" type="string" minOccurs="0">
                                        <annotation>
                                          <appinfo>
                                            <xrd:title>Eriomandi number korteriomandi puhul või juriidilise isiku nimi</xrd:title>
                                          </appinfo>
                                        </annotation>
                                      </element>
                                    </sequence>
                                  </complexType>
                                </element>
                              </sequence>
                            </complexType>
                          </element>
                        </sequence>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
              <element name="adsTase1" type="ads:adsTaseType" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Tase 1</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adsTase2" type="ads:adsTaseType" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Tase 2</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adsTase3" type="ads:adsTaseType" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Tase 3</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adsTase4" type="ads:adsTaseType" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Tase 4</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adsTase5" type="ads:adsTaseType" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Tase 5</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adsTase6" type="ads:adsTaseType" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Tase 6</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adsTase7" type="ads:adsTaseType" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Tase 7</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adsTase8" type="ads:adsTaseType" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Tase 8</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="muudetudTase" type="integer" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Taseme number, mis põhjustas aadressi muudatuse või tühistamise (U ja D sündmuse korral)</xrd:title>
                  </appinfo>
                </annotation>
              </element>
            </sequence>
          </complexType>
        </element>
      </sequence>
      </complexType>
      </element>
      <element name="fault" minOccurs="0">
        <complexType>
          <sequence>
            <element name="faultCode" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kood</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="faultString" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kirjeldus</xrd:title>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
      </sequence>
    </complexType>
  </element>
  <simpleType name="aadrSyndmusType">
    <restriction base="string">
      <enumeration value="I">
        <annotation>
          <appinfo>
            <xrd:title>lisamine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="U">
        <annotation>
          <appinfo>
            <xrd:title>muutmine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="D">
        <annotation>
          <appinfo>
            <xrd:title>tühistamine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="R">
        <annotation>
          <appinfo>
            <xrd:title>taastamine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="P">
        <annotation>
          <appinfo>
            <xrd:title>punkti muudatus</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="S">
        <annotation>
          <appinfo>
            <xrd:title>seoste kadumine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="N">
        <annotation>
          <appinfo>
            <xrd:title>sihtnumbri muudatus</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="A">
        <annotation>
          <appinfo>
            <xrd:title>mitteametliku piirkonna nime muudatus</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="O">
        <annotation>
          <appinfo>
            <xrd:title>prioriteetseima objekti muudatus</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="T">
        <annotation>
          <appinfo>
            <xrd:title>tehnilise tunnuse muudatus</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
    </restriction>
  </simpleType>

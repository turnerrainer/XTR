<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ads="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="https://x-road.eu/xsd/xroad.xsd"/>
  <include schemaLocation="https://www.maaamet.ee/schemas/xtee6/ads_types.xsd"/>
  <element name="ADSaadrmuudatused">
    <complexType>
      <annotation>
        <appinfo>
          <xrd:title>Aadressi muudatuste päring</xrd:title>
        </appinfo>
      </annotation>
      <sequence>
        <element name="muudetudAlates" minOccurs="0" type="date">
          <annotation>
            <appinfo>
              <xrd:title>Muudetud alates</xrd:title>
              <xrd:notes>Kuupäev alates millest (k.a) registreeritud muudatusi soovitakse leida</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="muudetudPaevad" minOccurs="0" default="1">
          <annotation>
            <appinfo>
              <xrd:title>Muudatuste päevade arv</xrd:title>
              <xrd:notes>Number vahemikus 1-10 mitme päeva muudatusi vastusesse soovitakse. Vaikimisi 1 päev</xrd:notes>
            </appinfo>
          </annotation>
          <simpleType>
            <restriction base="int">
              <minInclusive value="1"/>
              <maxInclusive value="10"/>
            </restriction>
          </simpleType>
        </element>
        <element name="logId" type="integer" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>LogId</xrd:title>
              <xrd:notes>Millisest LogId väärtusest suuremaid kirjeid otsitakse</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="maxarv" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tagastatav kirjete max arv</xrd:title>
            </appinfo>
          </annotation>
          <simpleType>
            <restriction base="integer">
              <maxInclusive value="100"/>
            </restriction>
          </simpleType>
        </element>
        <element name="pSyndmused" type="boolean" default="false" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta ka aadressi esinduspunkti muudatuse sündmus</xrd:title>
              <xrd:notes>True - tagastab ka P sündmuse, False - P sündmusi ei arvestata</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="sSyndmused" type="boolean" default="false" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta ka seoste kadumise sündmus</xrd:title>
              <xrd:notes>True - tagastab ka S sündmuse, False - S sündmusi ei arvestata</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="nSyndmused" type="boolean" default="false" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta ka sihtnumbri muudatuse sündmus</xrd:title>
              <xrd:notes>True - tagastab ka N sündmuse, False - N sündmusi ei arvestata</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="aSyndmused" type="boolean" default="false" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta ka mitteametliku piirkonna nime muudatuse sündmus</xrd:title>
              <xrd:notes>True - tagastab ka A sündmuse, False - A sündmusi ei arvestata</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="oSyndmused" type="boolean" default="false" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta ka primaarseima objekti viida tekkimise või muutumise sündmus</xrd:title>
              <xrd:notes>True – tagastab ka O sündmuse, False – O sündmusi ei arvesta</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="tSyndmused" type="boolean" default="false" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta ka aadressile tunnuse „tehniline“ omistamisel / eemaldamisel tekkiv sündmus</xrd:title>
              <xrd:notes>True – tagastab ka T sündmuse, False – T sündmusi ei arvesta</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="objekt" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Objekt</xrd:title>
              <xrd:notes>Kas tagastatakse ka muudatuse põhjustanud aadressiobjekti andmed.</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="seosed" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Seosobjektid</xrd:title>
              <xrd:notes>Kas tagastatakse ka muudatuse hetkel aadressiga seotud kehtivad objektid.</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="aadressKomp" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta aadress komponentidena</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="aadressJarglased" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta aadresside eellased/järglased</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="liidestujaObjektid" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta aadressiga seotud Kinnistusraamatu ja Äriregistri objektid</xrd:title>
            </appinfo>
          </annotation>
        </element>
      </sequence>
    </complexType>
  </element>
  <element name="ADSaadrmuudatusedResponse">
    <complexType>
      <sequence>
      <element name="muudatused" minOccurs="0">
        <complexType>
          <sequence>
            <element name="muudatus" maxOccurs="unbounded">
          <complexType>
            <sequence>
              <element name="logId" type="integer">
                <annotation>
                  <appinfo>
                    <xrd:title>Logikirje ID</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="logStamp" type="dateTime">
                <annotation>
                  <appinfo>
                    <xrd:title>Logikirje tekkimise aeg, muudatuse tegemise aeg koos kellaajaga</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="syndmus" type="ads:aadrSyndmusType">
                <annotation>
                  <appinfo>
                    <xrd:title>Sündmus</xrd:title>
                    <xrd:notes>I(insert) – aadress lisati süsteemi, U(update) – samade komponentidega aadressi tekst muutus, aadress versiooniti, D(delete) – aadress tühistati, R(restore) – aadress taastati
                      P – esinduspunkti koordinaate muudeti, S – aadressi kõik seosed kadusid, N – sihtnumber muutus, A – mitteametlik piirkond muutus, O – aadressi primaarobjekt muutus, T – lisati/eemaldati tunnus, et aadress on tehniline
                    </xrd:notes>
                  </appinfo>
                </annotation>
              </element>
              <element name="koodAadress" type="string">
                <annotation>
                  <appinfo>
                    <xrd:title>Koodaadress</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="adrId" type="integer">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadressi unikaalne võti</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="taisAadress" type="string">
                <annotation>
                  <appinfo>
                    <xrd:title>Normaliseeritud aadressitekst</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="lahiAadress" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Normaliseeritud lähiaadress</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="sihtnumber" type="integer" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Aadressile omistatud sihtnumber (postiindeks)</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="maPiirkond" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Mitteametliku piirkonna nimetus, millesse aadress kuulub</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="maPiirkondAlias" type="string" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Mitteametliku piirkonna nimetuse sünonüümid ehk alternatiivsed nimevariandid.</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="tehniline" type="boolean" minOccurs="0">
                <annotation>
                  <appinfo>
                    <xrd:title>Kas tegemist on tehnilise aadressiga</xrd:title>
                  </appinfo>

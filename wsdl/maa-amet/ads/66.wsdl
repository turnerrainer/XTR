            <xrd:title xml:lang="et">Muudatusi tagastavate teenuste järjehoidja info</xrd:title>
          </wsdl:documentation>
          <wsdl:input message="tns:logiInfo"/>
            <wsdl:output message="tns:logiInfoResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="serviceBinding" type="tns:servicePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

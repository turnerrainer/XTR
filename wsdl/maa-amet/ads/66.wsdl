<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ads="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
  <element name="logiInfo" type="ads:logiInfoRequestType"/>
  <complexType name="logiInfoRequestType">
    <annotation>
      <appinfo>
        <xrd:title>Muudatusi tagastavate teenuste järjehoidja info</xrd:title>
      </appinfo>
    </annotation>
    <sequence>
      <element name="muudetudAlates" type="date">
        <annotation>
          <appinfo>
            <xrd:title>Kuupäev alates millest (k.a) registreeritud muudatusi soovitakse leida</xrd:title>
          </appinfo>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <element name="logiInfoResponse" type="ads:logiInfoVastusType"/>
  <complexType name="logiInfoVastusType">
    <sequence>
      <element name="teenused" minOccurs="0">
        <complexType>
          <sequence>
      <element name="teenus" maxOccurs="unbounded">
        <complexType>
          <sequence>
            <element name="teenuseNimi" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>X-tee logiteenuse nimetus</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="logId" type="int">
              <annotation>
                <appinfo>
                  <xrd:title>Millisest LogId väärtusest suuremaid logisid on vaja lugeda</xrd:title>
                  <xrd:notes>logId väärtus, mis vastava teenuse sisendiks tuleks anda. Sama logId väärtus sobib ka manusepõhistele logiteenustele.</xrd:notes>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
</sequence>
</complexType>
</element>
    </sequence>
  </complexType>
</schema>

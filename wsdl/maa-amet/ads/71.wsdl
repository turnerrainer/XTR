<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ads="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
  <element name="ADSpoimuudatused">
    <complexType>
      <annotation>
        <appinfo>
          <xrd:title>Huvipunktide muudatused</xrd:title>
        </appinfo>
      </annotation>
      <sequence>
        <element name="muudetudAlates" minOccurs="0" type="date">
          <annotation>
            <appinfo>
              <xrd:title>Muudetud alates</xrd:title>
              <xrd:notes>Kuupäev alates millest (k.a) registreeritud muudatusi soovitakse leida
              </xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="muudetudPaevad" minOccurs="0" default="1">
          <annotation>
            <appinfo>
              <xrd:title>Muudatuste päevade arv</xrd:title>
              <xrd:notes>Number vahemikus 1-10 mitme päeva muudatusi vastusesse soovitakse.
                Vaikimisi 1 päev
              </xrd:notes>
            </appinfo>
          </annotation>
          <simpleType>
            <restriction base="int">
              <minInclusive value="1"/>
              <maxInclusive value="10"/>
            </restriction>
          </simpleType>
        </element>
        <element name="adsOid" minOccurs="0" type="string">
          <annotation>
            <appinfo>
              <xrd:title>Aadressiobjekti tunnus ADS süsteemis, millega seotud huvipunkte otsitakse
              </xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="logId" minOccurs="0" type="integer">
          <annotation>
            <appinfo>
              <xrd:title>LogId</xrd:title>
              <xrd:notes>Millisest LogId väärtusest suuremaid kirjeid otsitakse</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="maxarv" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tagastatav kirjete max arv</xrd:title>
            </appinfo>
          </annotation>
          <simpleType>
            <restriction base="integer">
              <maxInclusive value="100"/>
            </restriction>
          </simpleType>
        </element>
      </sequence>
    </complexType>
  </element>
  <element name="ADSpoimuudatusedResponse">
    <complexType>
      <sequence>
        <element name="poimuudatusedTulem" minOccurs="0">
          <complexType>
            <sequence>
              <element name="muudatus" maxOccurs="unbounded">
                <complexType>
                  <sequence>
                    <element name="logId" type="integer">
                      <annotation>
                        <appinfo>
                          <xrd:title>Logikirje ID</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="logStamp" type="date">
                      <annotation>
                        <appinfo>
                          <xrd:title>Logikirje tekkimise kuupäev</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="syndmus" minOccurs="0" type="ads:poiSyndmusType">
                      <annotation>
                        <appinfo>
                          <xrd:title>Sündmus</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="adsOid" minOccurs="0" type="string">
                      <annotation>
                        <appinfo>
                          <xrd:title>Objekti ADS süsteemi kood (objekti identifikaator ADS
                            süsteemis)
                          </xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="origTunnus" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>Objekti tunnus originaalregistris</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="taisAadress" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>Objekti täielik tekstiline aadress(täisaadress)</xrd:title>
                          <xrd:notes>Sisaldab kõiki paralleelaadresse pikal optimeeritud kujul
                          </xrd:notes>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="lahiAadress" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>Objekti lähiaadress, mis sisaldab kõiki paralleelaadresse
                          </xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiId" type="integer">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI objekti üheselt identifitseeriv tunnus</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiNimi" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>Huvipunkti ADS süsteemis omistatud nimi</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiAlias" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>Huvipunkti ADS süsteemis omistatud alias</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiYlemgrupp" type="integer" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI tüübi ülemgrupi kood</xrd:title>
                          <xrd:notes>Klassifikaator sisaldab järgmisi väärtuseid: 10 - riigihaldus;
                            11 – haridus; 12 - tervis; 13 – vaba aeg; 14 - teenused; 15 - transport;
                            16 – keskkond
                          </xrd:notes>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiGrupp" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI tüübi gruppi iseloomustav nimetus</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiAlamgrupp" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI tüübi alamgruppi iseloomustav nimetus</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiTyypnimi" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI tüüpi iseloomustav nimetus</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiTyyp" type="integer" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI tüübi kood numbrina</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiX" type="double" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>ADS süsteemis omistatud POI viitepunkti X</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiY" type="double" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>ADS süsteemis omistatud POI viitepunkti Y</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiAndmeallikas" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI allikregistri nimi, kust andmed algselt pärit on
                          </xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiVID" type="string" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI identifikaator allikregistris</xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                    <element name="poiAndmeseisKp" type="date" minOccurs="0">
                      <annotation>
                        <appinfo>
                          <xrd:title>POI andmeseisu viimase värskendamise kuupäev allikregistrist
                          </xrd:title>
                        </appinfo>
                      </annotation>
                    </element>
                  </sequence>
                </complexType>
              </element>
            </sequence>
          </complexType>
        </element>
        <element name="fault" minOccurs="0">
          <complexType>
            <sequence>
              <element name="faultCode" type="string">
                <annotation>
                  <appinfo>
                    <xrd:title>Vea kood</xrd:title>
                  </appinfo>
                </annotation>
              </element>
              <element name="faultString" type="string">
                <annotation>
                  <appinfo>
                    <xrd:title>Vea kirjeldus</xrd:title>
                  </appinfo>
                </annotation>
              </element>
            </sequence>
          </complexType>
        </element>
      </sequence>
    </complexType>
  </element>
  <simpleType name="poiSyndmusType">
    <restriction base="string">
      <enumeration value="U">
        <annotation>
          <appinfo>
            <xrd:title>muutmine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="D">
        <annotation>
          <appinfo>
            <xrd:title>eemaldamine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
    </restriction>
  </simpleType>
</schema>
</wsdl:types>
    <wsdl:message name="requestHeader">
        <wsdl:part name="client" element="xrd:client"/>
        <wsdl:part name="service" element="xrd:service"/>
        <wsdl:part name="id" element="xrd:id"/>
        <wsdl:part name="userId" element="xrd:userId"/>
        <wsdl:part name="issue" element="xrd:issue"/>
        <wsdl:part name="protocolVersion" element="xrd:protocolVersion"/>
    </wsdl:message>
    <wsdl:message name="ADSpoimuudatused">
        <wsdl:part name="body" element="tns:ADSpoimuudatused"/>
    </wsdl:message>
    <wsdl:message name="ADSpoimuudatusedResponse">
        <wsdl:part name="body" element="tns:ADSpoimuudatusedResponse"/>
    </wsdl:message>
    <wsdl:portType name="servicePortType">
        <wsdl:operation name="ADSpoimuudatused">
          <wsdl:documentation>
            <xrd:title xml:lang="et">Huvipunktide muudatused</xrd:title>
          </wsdl:documentation>
          <wsdl:input message="tns:ADSpoimuudatused"/>
            <wsdl:output message="tns:ADSpoimuudatusedResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="serviceBinding" type="tns:servicePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="ADSpoimuudatused">
            <soap:operation soapAction="" style="document"/>
            <xrd:version>v1</xrd:version>
            <wsdl:input>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="xroadeuService">
        <wsdl:port binding="tns:serviceBinding" name="xroadeuServicePort">
            <soap:address location="http://example.org/xroad-endpoint"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
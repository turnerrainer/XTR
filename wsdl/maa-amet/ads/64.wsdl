<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ads="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
  <include schemaLocation="http://www.maaamet.ee/schemas/xtee6/ads_types.xsd"/>
  <element name="ADSobjotsing" type="ads:ADSobjotsingRequestType"/>
  <complexType name="ADSobjotsingRequestType">
    <annotation>
      <appinfo>
        <xrd:title>Aadressiobjektide otsing</xrd:title>
      </appinfo>
    </annotation>
    <sequence>
      <element name="origRegister" minOccurs="0" type="ads:adsesitajaKlassifikaator">
        <annotation>
          <appinfo>
            <xrd:title>Objekti päritoluregister</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="objektiLiik" minOccurs="0" type="ads:adsobjliikKlassifikaator">
        <annotation>
          <appinfo>
            <xrd:title>Aadressiobjekti liik</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="adsOid" minOccurs="0" type="string">
        <annotation>
          <appinfo>
            <xrd:title>Objekti tunnus ADS süsteemis</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="origId" minOccurs="0" type="string">
        <annotation>
          <appinfo>
            <xrd:title>Objekti tunnus päritoluregistris</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="adrId" minOccurs="0" type="integer">
        <annotation>
          <appinfo>
            <xrd:title>Otsitava aadressi versiooni id</xrd:title>
            <xrd:notes>kui see on väljakutsujal teada. Teenus tagastab ainult aadressiga seotud kehtivad objektid. Mõjuvad ka teised tingimused, kui need on sisendis väärtustatud, va  seotudAdsOid</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="xKoord" minOccurs="0" type="double">
        <annotation>
          <appinfo>
            <xrd:title>Aadressipunkti x-koordinaat L-Est süsteemis</xrd:title>
            <xrd:notes>Väärtus vahemikus 6300000 - 6700000</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="yKoord" minOccurs="0" type="double">
        <annotation>
          <appinfo>
            <xrd:title>Aadressipunkti y-koordinaat L-Est süsteemis</xrd:title>
            <xrd:notes>Väärtus vahemikus 300000 - 800000</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="ulatus" minOccurs="0" type="double">
        <annotation>
          <appinfo>
            <xrd:title>Ulatus</xrd:title>
            <xrd:notes>Päringutingimuseks oleva ala ruudu pool külje pikkust meetrites</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="lahiAadress" minOccurs="0" type="string">
        <annotation>
          <appinfo>
            <xrd:title>Lähiaadressi osa tekstilisel kujul</xrd:title>
            <xrd:notes>Teatud juhtudel võib olla tarvis täpsustada lähiaadress, kui lähiaadressis sisalduv sõna ühtib EHAK objekti nimega.</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="aadressTekst" minOccurs="0" type="string">
        <annotation>
          <appinfo>
            <xrd:title>Aadress või selle osa tekstilisel kujul</xrd:title>
            <xrd:notes>Aadressiosad eralda komaga, samuti on soovitav kasutada kohanime täpsustavaid tunnuseid (linn, linnaosa, tänav, tn, vald, v, maakond, mk, alev  jn.) nt: Harju maakond, Tallinna linn, Kristiine linnaosa, Vindi tn või Tartu maakond, Vana-Kuuste küla</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="otsinguMeetod" minOccurs="0" default="1">
        <annotation>
          <appinfo>
            <xrd:title>Otsingu meetod</xrd:title>
            <xrd:notes>Võimalikud väärtused 1 (otsitakse aadresse, milles esinevad kõik sisestatud aadressi osad)ja 2 (otsitakse aadresse, milles esineb vähemalt üks sisestatud aadressi osadest).</xrd:notes>
          </appinfo>
        </annotation>
        <simpleType>
          <restriction base="int">
            <enumeration value="1">
              <annotation>
                <appinfo>
                  <xrd:title>JA - otsitakse aadresse, milles esinevad kõik sisestatud aadressi osad</xrd:title>
                </appinfo>
              </annotation>
            </enumeration>
            <enumeration value="2">
              <annotation>
                <appinfo>
                  <xrd:title>VÕI - otsitakse aadresse, milles esineb vähemalt üks sisestatud aadressi osadest</xrd:title>
                </appinfo>
              </annotation>
            </enumeration>
          </restriction>
        </simpleType>
      </element>
      <element name="huviPunktiNimi" minOccurs="0" type="string">
        <annotation>
          <appinfo>
            <xrd:title>Objektiga seotud huvipunkti nimi</xrd:title>
            <xrd:notes>Atribuudile rakendub otsingu täpsuse määrang, kuid ei rakendu otsingu meetod. Otsing toimub suur- väiketähtedest sõltumatult</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="otsinguTapsus" minOccurs="0" default="1">
        <annotation>
          <appinfo>
            <xrd:title>Otsingu täpsus</xrd:title>
            <xrd:notes>Võimalikud väärtused 1 (TÄPNE), 2 (ALGUSEST).</xrd:notes>
          </appinfo>
        </annotation>
        <simpleType>
          <restriction base="int">
            <enumeration value="1">
              <annotation>
                <appinfo>
                  <xrd:title>TÄPNE</xrd:title>
                </appinfo>
              </annotation>
            </enumeration>
            <enumeration value="2">
              <annotation>
                <appinfo>
                  <xrd:title>ALGUSEST</xrd:title>
                </appinfo>
              </annotation>
            </enumeration>
          </restriction>
        </simpleType>
      </element>
      <element name="syno" type="boolean" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Otsi ka sünonüümide hulgast</xrd:title>
            <xrd:notes>True - otsitakse ka sünonüümide hulgast, False - otsitakse ainult ametlike tekstide hulgast</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="seotudAdsOid" minOccurs="0" type="string">
        <annotation>
          <appinfo>
            <xrd:title>Seotud aadressiobjekti ADS OID</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <!-- Tagastuse juhtimine-->
      <element name="hulk" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta ainult aadressiobjektide arv</xrd:title>
            <xrd:notes>True - vastuseks tagastatakse leitud objektide arv ning ülejäänud tagastusparameetrite määranguid ignoreeritakse, False - tagastatakse leitud objektid ning arvestatakse järgnevaid tagastusparameetreid</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="andmeVektor" type="string" minOccurs="0" default="000">
        <annotation>
          <appinfo>
            <xrd:title>Andmevektor</xrd:title>
            <xrd:notes>Andmevektor on kolmest sümbolist koosnev string. Eraldi positsioonis sümbolitega (0,1) tähistatakse, millised andmed teenus tagastab. Esimene positsioon tähistab objekti tärk-, teine ruumi- ja kolmas aadressiandmeid.</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="aadressKomp" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta aadress komponentidena</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="EHRlisaandmed" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>EHR registrist pärit objekti korral tagasta ka mõned täiendavad atribuudid</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="probleemid" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta objekti probleemid ja märkused</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="objJarglased" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta objekti eellased/järglased</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="seotudObjektid" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Hoonetega või katastriüksustega seotud objektid</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="seotudHooneosad" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagastusse lisandub seotud hooneosade plokk</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="huviPunktid" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta objektiga seotud huvipunktide (POI) nimed</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="liidestujaObjektid" type="boolean" minOccurs="0" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta objektiga seotud Kinnistusraamatu ja Äriregistri objektid</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="alatesOid" type="string" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>OID, millisest alates tulemus tagastatakse</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="maxarv" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Tagastatav kirjete max arv</xrd:title>
          </appinfo>
        </annotation>
        <simpleType>
          <restriction base="integer">
            <maxInclusive value="100"/>
          </restriction>
        </simpleType>
      </element>
      <element name="ruumiAndmeteFormaat" type="ads:kujuGeomeetriaFormaatType" minOccurs="0" default="GML">
        <annotation>
          <appinfo>
            <xrd:title>
              Millises formaadis (WKT, GML, GeoJSON) tagastada objekti kuju geomeetria.
            </xrd:title>
            <xrd:notes>GML versioon 3.1.1</xrd:notes>
          </appinfo>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <element name="ADSobjotsingResponse" type="ads:ADSobjotsingVastusType"/>
  <complexType name="ADSobjotsingVastusType">
    <sequence>
      <element name="objektideArv" minOccurs="0" type="integer">
        <annotation>
          <appinfo>
            <xrd:title>Objektide arv</xrd:title>
            <xrd:notes>Päringutingimustele vastavate objektide arv (tagastatakse ainult siis kui sooviti saada objektide hulka)</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="jargmineOid" type="string" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Järgmine OID</xrd:title>
            <xrd:notes>Järgmise objekti OID, millest alates järgmist portsu küsida. Tagastatakse siis, kui päring oli suurem kui võimalik korraga tagastada ja kasutaja ei piiranud ise kirjete arvu</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="adsobjektid" minOccurs="0">
        <complexType>
          <sequence>
            <element name="adsobjekt" maxOccurs="unbounded">
              <complexType>
                <sequence>
                  <element name="adsOid" type="string">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti ADS OID</xrd:title>
                        <xrd:notes>Objekti ADS süsteemi kood</xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="adobId" type="integer">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti vers. id</xrd:title>
                        <xrd:notes>Objekti versiooni tunnus ADS süsteemis</xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="origTunnus" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti tunnus päritoluregistris</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="aadress" type="string">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti aadress</xrd:title>
                        <xrd:notes>Objekti täielik tekstiline aadress, mis sisaldab kõiki paralleelaadresse pikal optimeerimata kujul</xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="lahiAadress" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti lähiaadress</xrd:title>
                        <xrd:notes>Objekti lähiaadress, mis sisaldab kõiki paralleelaadresse</xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="objektiUrl" type="anyURI" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Link andmete kaardil vaatamiseks</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="aadrProbleeme" type="integer" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti aadressi kehtivate probleemide arv</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="eellased" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti võimalikeks eellasteks olevate objektide ADS_OID väärtuste loetelu. Loetelu eraldatud semikoolonitega.</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="jarglased" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti võimalikeks järglasteks olevate objektide ADS_OID väärtuste loetelu. Loetelu eraldatud semikoolonitega.</xrd:title>
                        <xrd:notes>Järglased on võimalikud ainult tühistatud komponentide korral</xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="unikaalne" type="boolean" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekt on unikaalaadressi tunnusega</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="hooneOID" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Hooneosa puhul selle hoone ADS süsteemi kood, millesse hooneosa kuulub</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="tekkimiseAlus" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Versiooni tekkimise õiguslik alus</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="kehtivAlates" type="date" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Versiooni tekkimise õigusliku aluse kuupäev</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="esitatud" type="dateTime" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Versiooni andmete ADS süsteemile esitamise kuupäev</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="hooneKujuPindala" type="double" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Hoone 2D kuju alusel arvutatud pindala m2 täpsusega 1 koht peale koma</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="hooneKorgusR" type="double" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Hoone räästa kõrgus m sellise täpsusega nagu on ETAK andmetes</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="hooneKorgusM" type="double" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Hoone maksimaalne (harja) kõrgus m sellise täpsusega nagu on ETAK andmetes</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="hooneosaKorrus" type="double" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Hooneosa sissepääsu korrus EHR andmetest, kui see on teada</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="ruumiKuju" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Ruumikuju</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="kujuMoodustusviis" type="ads:adsObjmviisType" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Kuju moodustusviis</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="tsentroidX" type="double" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Tsentroidi x-koordinaat L-Est süsteemis (northing)</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="tsentroidY" type="double" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Tsentroidi y-koordinaat L-Est süsteemis (easting)</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="etakId" type="integer" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objektiga seotud ETAK_ID</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="aadressid" minOccurs="0">
                    <complexType>
                      <sequence>
                        <element name="aadress" maxOccurs="unbounded">
                          <complexType>
                            <sequence>
                              <element name="adrId" type="integer">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>ADR_ID</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="koodAadress" type="string" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Koodaadress</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="taisAadress" type="string" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Normaliseeritud aadressitekst</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="lahiAadress" type="string" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Normaliseeritud lähiaadress</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="sihtnumber" type="integer" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Aadressile omistatud sihtnumber (postiindeks)</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="maPiirkond" type="string" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Mitteametliku piirkonna nimetus, millesse aadress kuulub</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="maPiirkondAlias" type="string" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Mitteametliku piirkonna nimetuse sünonüümid ehk alternatiivsed nimevariandid.</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="punktX" type="double" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Aadressipunkti x-koordinaat</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="punktY" type="double" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Aadressipunkti y-koordinaat</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="tehniline" type="boolean" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Kas on tehniline aadress</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="primaarseimObjekt" type="string" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Primaarseima objekt ADS-OID</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="adsTase1" type="ads:adsTaseType" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Tase 1</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="adsTase2" type="ads:adsTaseType" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Tase 2</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="adsTase3" type="ads:adsTaseType" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Tase 3</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="adsTase4" type="ads:adsTaseType" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Tase 4</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="adsTase5" type="ads:adsTaseType" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Tase 5</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="adsTase6" type="ads:adsTaseType" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Tase 6</xrd:title>
                                  </appinfo>
                                </annotation>

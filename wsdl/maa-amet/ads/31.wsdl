<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ads="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
  <include schemaLocation="http://www.maaamet.ee/schemas/xtee6/ads_types.xsd"/>
  <element name="ADSkomponendid" type="ads:ADSkomponendidRequestType"/>
  <complexType name="ADSkomponendidRequestType">
    <annotation>
      <appinfo>
        <xrd:title>Aadressikomponentide kehtiva seisu päring</xrd:title>
      </appinfo>
    </annotation>
    <sequence>
      <element name="ylemtase" minOccurs="0" type="ads:adstasemedKlassifikaator">
        <annotation>
          <appinfo>
            <xrd:title>Aadressikomponendi tase, millega seotud ja millest täpsemaid komponente päritakse</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="ylemkood" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Aadressikomponendi kood, millega seotud ja millest täpsemaid komponente päritakse</xrd:title>
          </appinfo>
        </annotation>
        <simpleType>
          <restriction base="string">
            <pattern value=".{0,4}"/>
          </restriction>
        </simpleType>
      </element>
      <element name="mintase" minOccurs="0" type="ads:adstasemedKlassifikaator">
        <annotation>
          <appinfo>
            <xrd:title>Päringu tulemusena väljastatavate komponentide miinimum tase</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="maxtase" minOccurs="0" type="ads:adstasemedKlassifikaator">
        <annotation>
          <appinfo>
            <xrd:title>Päringu tulemusena väljastatavate komponentide maksimum tase</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="alateskirjest" minOccurs="0" type="int" default="1">
        <annotation>
          <appinfo>
            <xrd:title>Mitmendast päringuga leitud objektist alates tagastatakse vastuste hulk</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="maxarv" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>Tagastatav kirjete max arv</xrd:title>
          </appinfo>
        </annotation>
        <simpleType>
          <restriction base="integer">
            <maxInclusive value="100"/>
          </restriction>
        </simpleType>
      </element>
      <element name="initObjektid" minOccurs="0" type="boolean" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta komponenti initsialiseerivad ADS-OID'id</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="kompSynonyymid" minOccurs="0" type="boolean" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta komponenti sünonüümid</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="kompEellased" minOccurs="0" type="boolean" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta komponenti eellased</xrd:title>
          </appinfo>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <element name="ADSkomponendidResponse" type="ads:ADSkomponendidVastusType"/>
  <complexType name="ADSkomponendidVastusType">
    <sequence minOccurs="0" maxOccurs="unbounded">
      <element name="paringTulem">
        <complexType>
          <sequence>
            <element name="tase" type="ads:adstasemedKlassifikaator">
              <annotation>
                <appinfo>
                  <xrd:title>Aadressikomponendi tase</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="kood" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Aadressikomponendi kood</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="nimetus" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Aadressikomponendi nimi ilma liigisõnata</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="nimiliigiga" type="string" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Aadressikomponendi nimi koos liigisõnaga</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="ylemtase" type="ads:adstasemedKlassifikaator" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Aadressikomponendi ülem-komponendi tase</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="ylemkood" type="string" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Aadressikomponendi ülem-komponendi kood</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="tehniline" type="boolean" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Tehniline komponent</xrd:title>
                  <xrd:notes>Tehnilised on sellised 6. taseme komponendid, millega seotud katastriüksused ei ole kohanimekohustusega</xrd:notes>
                </appinfo>
              </annotation>
            </element>
            <element name="ads_oid" type="string" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Initsialiseerivate objektide ADS_OID väärtused</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="synonyymid" type="string" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Komponendi sünonüümid, mis ei lange kokku komponendi ametlike nimekujudega</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="eellased" type="string" minOccurs="0">
              <annotation>
                <appinfo>
                  <xrd:title>Komponendi võimalikeks eellasteks olevate sama taseme tühistatud komponentide loetelu</xrd:title>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
    </sequence>
  </complexType>
</schema>
</wsdl:types>
    <wsdl:message name="requestHeader">
        <wsdl:part name="client" element="xrd:client"/>
        <wsdl:part name="service" element="xrd:service"/>
        <wsdl:part name="id" element="xrd:id"/>
        <wsdl:part name="userId" element="xrd:userId"/>
        <wsdl:part name="issue" element="xrd:issue"/>
        <wsdl:part name="protocolVersion" element="xrd:protocolVersion"/>
    </wsdl:message>
    <wsdl:message name="ADSkomponendid">
        <wsdl:part name="body" element="tns:ADSkomponendid"/>
    </wsdl:message>
    <wsdl:message name="ADSkomponendidResponse">
        <wsdl:part name="body" element="tns:ADSkomponendidResponse"/>
    </wsdl:message>
    <wsdl:portType name="servicePortType">
        <wsdl:operation name="ADSkomponendid">
          <wsdl:documentation>
            <xrd:title xml:lang="et">Aadressikomponentide kehtiva seisu päring</xrd:title>
          </wsdl:documentation>
          <wsdl:input message="tns:ADSkomponendid"/>
            <wsdl:output message="tns:ADSkomponendidResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="serviceBinding" type="tns:servicePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="ADSkomponendid">
            <soap:operation soapAction="" style="document"/>
            <xrd:version>v2</xrd:version>
            <wsdl:input>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="xroadeuService">
        <wsdl:port binding="tns:serviceBinding" name="xroadeuServicePort">
            <soap:address location="http://example.org/xroad-endpoint"/>
        </wsdl:port>
    </wsdl:service>

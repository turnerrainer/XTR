  <simpleType name="objektiSyndmusType">
    <restriction base="string">
      <enumeration value="I">
        <annotation>
          <appinfo>
            <xrd:title>lisamine</xrd:title>
            <xrd:notes>objektile lisandus seos aadressiga (eelmisel objekti versioonil ei olnud seda aadressi)</xrd:notes>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="U">
        <annotation>
          <appinfo>
            <xrd:title>muutmine</xrd:title>
            <xrd:notes>objekt muutis temaga seotud aadressi (eelmisel objekti versioonil oli sama koodiga kuid erineva ID-ga aadress)</xrd:notes>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="D">
        <annotation>
          <appinfo>
            <xrd:title>eemaldamine</xrd:title>
            <xrd:notes>objekti seos aadressiga kustus (eelmisel objekti versioonil oli seos, uuel ei ole enam)</xrd:notes>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="K">
        <annotation>
          <appinfo>
            <xrd:title>objekti aadresspunkt muutus</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
    </restriction>
  </simpleType>
  <simpleType name="objOlekType">

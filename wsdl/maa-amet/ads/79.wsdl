      <annotation>
        <appinfo>
          <xrd:title>Objekti aadresside muudatuste päring (ADSobjaadrmuudatusedV5)</xrd:title>
        </appinfo>
      </annotation>
      <sequence>
        <element name="muudetudAlates" minOccurs="0" type="date">
          <annotation>
            <appinfo>
              <xrd:title>Muudetud alates</xrd:title>
              <xrd:notes>Kuupäev alates millest (k.a) registreeritud muudatusi soovitakse leida</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="muudetudPaevad" minOccurs="0" default="1">
          <annotation>
            <appinfo>
              <xrd:title>Muudatuste päevade arv</xrd:title>
              <xrd:notes>Number vahemikus 1-10 ehk mitme päeva muudatusi vastusesse soovitakse. Vaikimisi 1 päev.</xrd:notes>
            </appinfo>
          </annotation>
          <simpleType>
            <restriction base="int">
              <minInclusive value="1"/>
              <maxInclusive value="10"/>
            </restriction>
          </simpleType>
        </element>
        <element name="objektiLiik" minOccurs="0" type="ads:adsobjliikKlassifikaator">
          <annotation>
            <appinfo>
              <xrd:title>Objekti liik</xrd:title>
              <xrd:notes>Objekti liik, millega seotud muudatusi soovitakse</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="logId" type="integer" minOccurs="0">

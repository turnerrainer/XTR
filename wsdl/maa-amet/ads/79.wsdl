        </element>
        <element name="aadressKomp" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta uus aadress komponentidena</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="aadressiSeosObjektid" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta aadressiga seotud aadressiobjektide andmed</xrd:title>
              <xrd:notes>Kas tagastatakse ka päringu hetkel aadressiga seotud kehtivas ja ootel olekus objektid.</xrd:notes>
            </appinfo>
          </annotation>
        </element>
      </sequence>
    </complexType>

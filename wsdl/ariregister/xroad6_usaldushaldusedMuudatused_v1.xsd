<?xml version="1.0" encoding="UTF-8" ?>
<xsd:schema
        targetNamespace="http://arireg.x-road.eu/producer/"
        elementFormDefault="qualified"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:sawsdl="http://www.w3.org/ns/sawsdl"
        xmlns:ar="http://arireg.x-road.eu/producer/">

    <xsd:complexType name="usaldushaldusedMuudatused_v1_Request">
        <xsd:sequence>
            <xsd:element name="ariregister_kasutajanimi" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Äriregistri kasutajanimi</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="ariregister_parool" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Äriregistri parool</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="muudatuse_kpv" type="xsd:date">
                <xsd:annotation>
                    <xsd:documentation>Muudatuste kuupäev</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="tulemuste_lk" type="xsd:int" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Vastuse lehekülje number, vaikeväärtus 1</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="tulemusi_lehel" type="xsd:int" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Mitu tulemust vastuses ühel lehel soovitakse, vaikimisi 1000 (tagastatavate ettevõtjate arv)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="usaldushaldusedMuudatused_v1_Vastus">
        <xsd:sequence>
            <xsd:element name="rida" type="ar:usaldushaldusedMuudatused_v1_rida" minOccurs="0" maxOccurs="unbounded">
                <xsd:annotation>
                    <xsd:documentation>Ettevõtja vastuses</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="tulemuste_arv" type="xsd:integer">
                <xsd:annotation>
                    <xsd:documentation>Ettevõtjate arv</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="usaldushaldusedMuudatused_v1_rida">
        <xsd:sequence>
            <xsd:element name="nimi" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Ärinimi</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="muudatuse_liik" type="ar:usaldushaldusedMuudatused_v1_muudatuseLiik">
                <xsd:annotation>
                    <xsd:documentation>Muudatuse liik</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="muudatuse_aeg" type="xsd:dateTime">
                <xsd:annotation>
                    <xsd:documentation>Muudatuse aeg</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="usaldushaldusedMuudatused_v1_muudatuseLiik">
        <xsd:restriction base="xsd:integer">
            <xsd:enumeration value="1">
                <xsd:annotation>
                    <xsd:documentation>Kasusaaja lisati kehtivaks</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="2">
                <xsd:annotation>
                    <xsd:documentation>Kasusaaja muudeti kehtetuks</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="3">
                <xsd:annotation>
                    <xsd:documentation>Kasusaaja andmeid muudeti</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="4">
                <xsd:annotation>
                    <xsd:documentation>Muudeti usaldushalduse või seotud isikute muudatus</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="usaldushaldusedMuudatused_v1">
        <xsd:sequence>
            <xsd:element name="keha" type="ar:usaldushaldusedMuudatused_v1_Request"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="usaldushaldusedMuudatused_v1Response">
        <xsd:sequence>
            <xsd:element name="paring" type="ar:usaldushaldusedMuudatused_v1_Request"/>
            <xsd:element name="keha" type="ar:usaldushaldusedMuudatused_v1_Vastus"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- wrapper declarations -->
    <xsd:element name="usaldushaldusedMuudatused_v1" type="ar:usaldushaldusedMuudatused_v1"/>
    <xsd:element name="usaldushaldusedMuudatused_v1Response" type="ar:usaldushaldusedMuudatused_v1Response"/>
    <!-- /wrapper declarations -->

</xsd:schema>

<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ads="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="https://x-road.eu/xsd/xroad.xsd"/>
  <include schemaLocation="https://www.maaamet.ee/schemas/xtee6/ads_types.xsd"/>
  <element name="ADSobjjarglased">
    <complexType>
      <annotation>
        <appinfo>
          <xrd:title>Tühistatud objekti järglaste päring</xrd:title>
        </appinfo>
      </annotation>
      <sequence>
        <element name="adobId" type="integer" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tühistatud objekti versioonitunnus ADS süsteemis</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="adsOid" type="string" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Objekti tunnus ADS süsteemis (ADS_OID)</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="andmeVektor" type="string" default="000">
          <annotation>
            <appinfo>
              <xrd:title>Andmevektor (juhib objekti järglaste tagastust)</xrd:title>
              <xrd:notes>
                Pos 1 – tärkandmed
                Pos 2 – ruumiandmed
                Pos 3 – aadressid eraldi kirjetena
              </xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="aadressKomp" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta uus aadress koos viidetega komponentidele</xrd:title>
              <xrd:notes>Parameetrit arvestatakse ainult siis, kui andmevektori 3. positsioonis on 1</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="ruumiAndmeteFormaat" type="ads:kujuGeomeetriaFormaatType" minOccurs="0" default="GML">
          <annotation>
            <appinfo>
              <xrd:title>
                Millises formaadis (WKT, GML, GeoJSON) tagastada objekti kuju geomeetria.
              </xrd:title>
              <xrd:notes>GML versioon 3.1.1</xrd:notes>
            </appinfo>
          </annotation>
        </element>
      </sequence>
    </complexType>
  </element>
  <element name="ADSobjjarglasedResponse" type="ads:ADSobjjarglasedVastusType"/>
  <complexType name="ADSobjjarglasedVastusType">
    <sequence>
      <element name="objJargTulem" minOccurs="0">
        <complexType>
          <sequence>
            <element name="objektiJarglane" maxOccurs="unbounded">
              <complexType>
                <sequence>
                  <element name="objektiLiik" type="ads:adsobjliikKlassifikaator">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti liik</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="adsOid" type="string">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti ADS süsteemi kood</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="adobId" type="integer">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti versioonitunnus ADS süsteemis</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="origTunnus" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti tunnus originaalregistris</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="taisAadress" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti täielik tekstiline aadress, mis sisaldab kõiki paralleelaadresse pikal optimeeritud kujul</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="lahiAadress" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekti lähiaadress, mis sisaldab kõiki paralleelaadresse</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="unikaalne" type="boolean" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Objekt on unikaalaadressi tunnusega</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="oiguslikAlus" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Versiooni tekkimise õiguslik alus</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="kehtivuseAlgus" type="date" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Versiooni õigusliku aluse kuupäev</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="esitatud" type="dateTime" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Versiooni andmete ADS süsteemis jõustumise kuupäev</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="ruumiKuju" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Aadressiobjekti kuju</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="punktX" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Tsentroidi x-koordinaat L-Est süsteemis</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="punktY" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Tsentroidi y-koordinaat L-Est süsteemis</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="aadressid" minOccurs="0">
                    <complexType>
                      <sequence>
                        <element name="aadress" minOccurs="0" maxOccurs="unbounded">
                          <complexType>
                            <sequence>
                              <element name="adrId" type="integer">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Aadressi unikaalne võti</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="koodAadress" type="string">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Koodaadress</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="taisAadress" type="string">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Normaliseeritud aadresstekst</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="lahiAadress" type="string" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Normaliseeritud lähiaadress</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="sihtnumber" type="integer" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Aadressile omistatud sihtnumber (postiindeks)</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>
                              <element name="maPiirkond" type="string" minOccurs="0">
                                <annotation>
                                  <appinfo>
                                    <xrd:title>Mitteametliku piirkonna nimetus, millesse aadress kuulub</xrd:title>
                                  </appinfo>
                                </annotation>
                              </element>

  <include schemaLocation="https://www.maaamet.ee/schemas/xtee6/ads_types.xsd"/>
  <element name="ADSobjjarglasedV4">
    <complexType>
      <annotation>
        <appinfo>
          <xrd:title>Tühistatud objekti järglaste päring (ADSobjjarglasedV4)</xrd:title>
        </appinfo>
      </annotation>
      <sequence>
        <element name="adobId" type="integer" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Tühistatud objekti versiooni ID ADS süsteemis (ADOB_ID)</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="adsOid" type="string" minOccurs="0">
          <annotation>
            <appinfo>
              <xrd:title>Objekti identifikaator ADS süsteemis (ADS_OID)</xrd:title>
            </appinfo>
          </annotation>
        </element>
        <element name="andmeVektor" type="string" default="000">
          <annotation>
            <appinfo>
              <xrd:title>Andmevektor</xrd:title>
              <xrd:notes>Andmevektor on kolmest sümbolist koosnev string. Eraldi positsioonis sümbolitega (0, 1) tähistatakse, millised andmed teenus tagastab. Esimene positsioon tähistab objekti tärk-, teine ruumi- ja kolmas aadressiandmeid. Vaikimisi 000.</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="aadressKomp" type="boolean" minOccurs="0" default="false">
          <annotation>
            <appinfo>
              <xrd:title>Tagasta uus aadress komponentidena</xrd:title>
              <xrd:notes>Parameetrit arvestatakse ainult siis, kui andmevektori 3. positsioonis on 1.</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="ruumiAndmeteFormaat" type="ads:kujuGeomeetriaFormaatType" minOccurs="0" default="GML">
          <annotation>
            <appinfo>
              <xrd:title>Millises formaadis (WKT, GML, GeoJSON) tagastada objekti kuju geomeetria</xrd:title>
              <xrd:notes>GML versioon 3.1.1</xrd:notes>
            </appinfo>
          </annotation>
        </element>
        <element name="objektiOlekud" type="string" minOccurs="0" default="KO">
          <annotation>
            <appinfo>
              <xrd:title>Tagastatava objekti olek</xrd:title>
              <xrd:notes>Tagastab soovitud olekutega objektid. Võimalikud väärtused:
                K – kehtiv,
                O – ootel.
                Vaikimisi tagastatakse K ja O olekus objektid.</xrd:notes>
            </appinfo>
          </annotation>
        </element>
      </sequence>
    </complexType>
  </element>

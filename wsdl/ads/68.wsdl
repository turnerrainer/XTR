<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd" xmlns:tns="http://www.maaamet.ee" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.maaamet.ee">
    <wsdl:types>

<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ads="http://www.maaamet.ee" targetNamespace="http://www.maaamet.ee" xmlns:xrd="http://x-road.eu/xsd/xroad.xsd">
  <import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
  <include schemaLocation="http://www.maaamet.ee/schemas/xtee6/ads_types.xsd"/>
  <element name="ADSkompklassif" type="ads:ADSkompklassifRequestType"/>
  <complexType name="ADSkompklassifRequestType">
    <annotation>
      <appinfo>
        <xrd:title>Aadressikomponentide klassifikaatori muudatuste päring</xrd:title>
      </appinfo>
    </annotation>
    <sequence>
      <element name="muudetudAlates" minOccurs="0" type="date">
        <annotation>
          <appinfo>
            <xrd:title>Muudetud alates</xrd:title>
            <xrd:notes>Kuupäev alates millest (k.a.) registreeritud muudatusi soovitakse leida
            </xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="muudetudPaevad" minOccurs="0" default="1">
        <annotation>
          <appinfo>
            <xrd:title>Muudatuste päevade arv</xrd:title>
            <xrd:notes>Number vahemikus 1-10 mitme päeva muudatusi vastusesse soovitakse. Vaikimisi
              1 päev
            </xrd:notes>
          </appinfo>
        </annotation>
        <simpleType>
          <restriction base="int">
            <minInclusive value="1"/>
            <maxInclusive value="10"/>
          </restriction>
        </simpleType>
      </element>
      <element name="objektiLiik" minOccurs="0" type="ads:adsobjliikKlassifikaator">
        <annotation>
          <appinfo>
            <xrd:title>Objekti liik</xrd:title>
            <xrd:notes>Muudatuse põhjustanud aadressiobjekti liik</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="minTase" minOccurs="0" type="ads:adstasemedKlassifikaator">
        <annotation>
          <appinfo>
            <xrd:title>Min. tase</xrd:title>
            <xrd:notes>Minimaalne tase (üldisemast täpsema suunas), mille muudatused vastusesse
              tulevad
            </xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="maxTase" minOccurs="0" type="ads:adstasemedKlassifikaator">
        <annotation>
          <appinfo>
            <xrd:title>Max. tase</xrd:title>
            <xrd:notes>Maksimaalne tase (üldisemast täpsema suunas), mille muudatused vastusesse
              tulevad
            </xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="logId" type="integer" minOccurs="0">
        <annotation>
          <appinfo>
            <xrd:title>LogId</xrd:title>
            <xrd:notes>Millisest LogId väärtusest suuremaid kirjeid otsitakse</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="maxarv" minOccurs="0" default="100">
        <annotation>
          <appinfo>
            <xrd:title>Maksimaalne tagastavate kirjete arv</xrd:title>
          </appinfo>
        </annotation>
        <simpleType>
          <restriction base="int">
            <minInclusive value="1"/>
            <maxInclusive value="100"/>
          </restriction>
        </simpleType>
      </element>
      <element name="sSyndmused" type="boolean" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta ka seoste kadumise sündmus</xrd:title>
            <xrd:notes>True - tagastab ka S sündmuse, False - S sündmusi ei arvestata</xrd:notes>
          </appinfo>
        </annotation>
      </element>
      <element name="initObjektid" type="boolean" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta komponenti initsialiseerivad ADS-OID'id</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="kompSynonyymid" type="boolean" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta komponenti sünonüümid</xrd:title>
          </appinfo>
        </annotation>
      </element>
      <element name="kompJarglased" type="boolean" default="false">
        <annotation>
          <appinfo>
            <xrd:title>Tagasta komponenti eellased/järglased</xrd:title>
          </appinfo>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <element name="ADSkompklassifResponse" type="ads:ADSkompklassifVastusType"/>
  <complexType name="ADSkompklassifVastusType">
    <sequence>
      <element name="klassifTulem" minOccurs="0">
        <complexType>
          <sequence>
            <element name="muudatus" maxOccurs="unbounded">
              <complexType>
                <sequence>
                  <element name="logId" type="integer">
                    <annotation>
                      <appinfo>
                        <xrd:title>Logikirje ID</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="logStamp" type="dateTime">
                    <annotation>
                      <appinfo>
                        <xrd:title>Logikirje tekkimise aeg</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="syndmus" type="ads:klassifSyndmusType">
                    <annotation>
                      <appinfo>
                        <xrd:title>Sündmus</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="tase" type="integer">
                    <annotation>
                      <appinfo>
                        <xrd:title>Aadressikomponendi tase</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="kood" type="string">
                    <annotation>
                      <appinfo>
                        <xrd:title>Aadressikomponendi kood</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="nimetus" type="string">
                    <annotation>
                      <appinfo>
                        <xrd:title>Nimetus</xrd:title>
                        <xrd:notes>Aadressikomponendi nimi ilma liigisõnata</xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="nimetusLiigiga" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Nimetus liigiga</xrd:title>
                        <xrd:notes>Aadressikomponendi nimi koos liigisõnaga</xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="ylemTase" type="integer" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Ülem-komponendi tase</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="ylemKood" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Ülem-komponendi Kood</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="vanaNimetus" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Vana nimetus</xrd:title>
                        <xrd:notes>Aadressikomponendi vana nimi ilma liigisõnata komponendi muutmise
                          korral
                        </xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="vanaNimetusLiigiga" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Vana nimetus liigiga</xrd:title>
                        <xrd:notes>Aadressikomponendi vana nimi koos liigisõnaga komponendi muutmise
                          korral
                        </xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="muutjaAdsOID" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Muudatuse põhjustanud objekti ADS_OID</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="oiguslikAlus" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Muudatuse põhjustanud objekti õiguslik alus</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="aluseKuup" type="date" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Muudatuse põhjustanud objekti õigusliku aluse kuupäev</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="tehniline" type="boolean">
                    <annotation>
                      <appinfo>
                        <xrd:title>Tehniline komponent</xrd:title>
                        <xrd:notes>Tehnilised on sellised 6. taseme komponendid, millega seotud
                          katastriüksused ei ole kohanimekohustusega
                        </xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="poleSeotud" type="boolean">
                    <annotation>
                      <appinfo>
                        <xrd:title>Komponent on kehtetu ja pole kasutusel mitte üheski kehtivas
                          aadressis
                        </xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="adsOID" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Initsialiseerivate objektide ADS_OID väärtused</xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="synonyymid" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Sünonüümid</xrd:title>
                        <xrd:notes>Komponendi sünonüümid, mis ei lange kokku komponendi ametlike
                          nimekujudega
                        </xrd:notes>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="eellased" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Komponendi võimalikeks eellasteks olevate sama taseme tühistatud
                          komponentide loetelu
                        </xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                  <element name="jarglased" type="string" minOccurs="0">
                    <annotation>
                      <appinfo>
                        <xrd:title>Komponendi võimalikeks järglaseks olevate sama taseme
                          komponentide loetelu
                        </xrd:title>
                      </appinfo>
                    </annotation>
                  </element>
                </sequence>
              </complexType>
            </element>
          </sequence>
        </complexType>
      </element>
      <element name="fault" minOccurs="0">
        <complexType>
          <sequence>
            <element name="faultCode" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kood</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="faultString" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kirjeldus</xrd:title>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
    </sequence>
  </complexType>
  <simpleType name="klassifSyndmusType">
    <restriction base="string">
      <enumeration value="I">
        <annotation>
          <appinfo>
            <xrd:title>lisamine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="U">
        <annotation>
          <appinfo>
            <xrd:title>muutmine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="D">
        <annotation>
          <appinfo>
            <xrd:title>tühistamine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="R">
        <annotation>
          <appinfo>
            <xrd:title>taastamine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
      <enumeration value="S">
        <annotation>
          <appinfo>
            <xrd:title>seoste kadumine</xrd:title>
          </appinfo>
        </annotation>
      </enumeration>
    </restriction>
  </simpleType>
</schema>
</wsdl:types>
    <wsdl:message name="requestHeader">
        <wsdl:part name="client" element="xrd:client"/>
        <wsdl:part name="service" element="xrd:service"/>
        <wsdl:part name="id" element="xrd:id"/>
        <wsdl:part name="userId" element="xrd:userId"/>
        <wsdl:part name="issue" element="xrd:issue"/>
        <wsdl:part name="protocolVersion" element="xrd:protocolVersion"/>
    </wsdl:message>
    <wsdl:message name="ADSkompklassif">
        <wsdl:part name="body" element="tns:ADSkompklassif"/>
    </wsdl:message>
    <wsdl:message name="ADSkompklassifResponse">
        <wsdl:part name="body" element="tns:ADSkompklassifResponse"/>
    </wsdl:message>
    <wsdl:portType name="servicePortType">
        <wsdl:operation name="ADSkompklassif">
          <wsdl:documentation>
            <xrd:title xml:lang="et">Aadressikomponentide klassifikaatori muudatuste päring</xrd:title>
          </wsdl:documentation>
          <wsdl:input message="tns:ADSkompklassif"/>
            <wsdl:output message="tns:ADSkompklassifResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="serviceBinding" type="tns:servicePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="ADSkompklassif">
            <soap:operation soapAction="" style="document"/>
            <xrd:version>v2</xrd:version>
            <wsdl:input>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
                <soap:header message="tns:requestHeader" part="client" use="literal"/>
                <soap:header message="tns:requestHeader" part="service" use="literal"/>
                <soap:header message="tns:requestHeader" part="id" use="literal"/>
                <soap:header message="tns:requestHeader" part="userId" use="literal"/>
                <soap:header message="tns:requestHeader" part="issue" use="literal"/>
                <soap:header message="tns:requestHeader" part="protocolVersion" use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="xroadeuService">
        <wsdl:port binding="tns:serviceBinding" name="xroadeuServicePort">
            <soap:address location="http://example.org/xroad-endpoint"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
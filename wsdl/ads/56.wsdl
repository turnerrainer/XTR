                                            </annotation>
                                          </element>
                                          <element name="lisainfo" type="string" minOccurs="0">
                                            <annotation>
                                              <appinfo>
                                                <xrd:title>Eriomandi number korteriomandi puhul või juriidilise isiku nimi</xrd:title>
                                              </appinfo>
                                            </annotation>
                                          </element>
                                        </sequence>
                                      </complexType>
                                    </element>
                                  </sequence>
                                </complexType>
                              </element>
                            </sequence>

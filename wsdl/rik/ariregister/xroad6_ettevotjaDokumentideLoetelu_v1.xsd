<?xml version="1.0" encoding="UTF-8" ?> 
<xsd:schema
    targetNamespace="http://arireg.x-road.eu/producer/"
    elementFormDefault="qualified"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:swa="http://ws-i.org/profiles/basic/1.1/xsd"
    xmlns:sawsdl="http://www.w3.org/ns/sawsdl"
    xmlns:xrd="http://x-road.eu/xsd/xroad.xsd"
    xmlns:ar="http://arireg.x-road.eu/producer/">

    <xsd:complexType name="ettevotja_dokumentide_loetelu_paring_v2">
        <xsd:sequence>

            <xsd:element name="ariregister_kasutajanimi" type="xsd:string" nillable="true" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri kasutajanimi</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element name="ariregister_parool" type="xsd:string" nillable="true" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri parool</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="ariregistri_kood" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Maakohtu_poolt_registreeritud_isik_ariregistrikood" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Mis ettevõtte kohta dokumente päritakse. Kohustuslik, kui pole kuupäeva.</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri kood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="kuupaev" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kuupaev" type="xsd:date">
                <xsd:annotation>
                    <xsd:documentation>Näitab, millise kuupäeva kohta dokumente päritakse. Kohustuslik, kui pole äriregistri koodi.</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kuupäev</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="lehekylg" type="xsd:integer">
                <xsd:annotation>
                    <xsd:documentation>Näitab mitmendat valimit andmetest päritakse. Kohustuslik, kui teostatakse päring kuupäeva järgi.</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Lehekülg</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="aruandeaasta" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Aruandeaasta" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Näitab, millise aasta kohta majandusaasta aruannete linke saada soovitakse. Põhikirju aasta numbri järgi otsida ei saa. Kasutatakse ainult ariregistri koodiga otsingus.</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Aruandeaasta</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="dokumendi_liik" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Dokumendi_liik" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>A – majandusaasta aruanded PDF, D - majandusaasta aruanded BDOC, DDOC, I - majandusaasta aruanded iXBRL ZIP, X - majandusaasta aruanded XBRL, P – põhikirjad, K - majandusaasta aruanded ja põhikirjad (vaikimisi)</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Dokumendi liik</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="dokumendi_kehtivus" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Dokumendi_kehtivus" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>K – kehtiv (vaikimisi), A – ajaloolised ja kehtivad</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Dokumendi kehtivus</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="keel" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Klassifikaatorite_keel" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Pole kasutusel</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Klassifikaatorite tõlgete keel</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="get_access_token" type="xsd:boolean">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Kas tagastada ligipääsuluba e-äriregistris</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotja_dokumentide_loetelu_vastus_v2">
        <xsd:sequence>

            <xsd:element minOccurs="0" maxOccurs="unbounded" name="ettevotja_dokumendid" type="ar:ettevotja_dokument">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Ettevotja dokument</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element minOccurs="0" maxOccurs="1" name="lehekylgede_arv" type="xsd:integer">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Lehekülgede arv</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element minOccurs="0" maxOccurs="1" name="access_token" type="xsd:string">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Tasulise päringu ligipääsuluba e-äriregistris, kui soovitakse pärida dokumente eelnevalt sisselogimata, lisada dokumendi_url väärtusele parameetriga "access_token", kasutamisel ostetakse dokument, eraldi kinnitust pole</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotja_dokument">
        <xsd:sequence>

            <xsd:element name="dokumendi_id" type="xsd:integer">
                <xsd:annotation>
                    <xsd:documentation>Dokumendi ID, saab kasutada sisendina teenuses arireg.toimiku_dokument.v1.</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Dokumendi ID</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element name="ariregistri_kood" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Maakohtu_poolt_registreeritud_isik_ariregistrikood" type="xsd:int">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri kood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="dokumendi_liik" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Dokumendi_liik" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>A – majandusaasta aruanded PDF, D - majandusaasta aruanded BDOC, DDOC, I - majandusaasta aruanded iXBRL ZIP, X - majandusaasta aruanded XBRL, P – põhikirjad</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Dokumendi liik</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="dokumendi_nimetus" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Dokumendi_nimetus" type="xsd:string">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Dokumendi nimetus</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="dokumendi_suurus" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Dokumendi_suurus" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Väärtus on -1, kui suurust ei ole määratud.</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Dokumendi suurus baitides</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="dokumendi_seisu_kuupaev" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Dokumendi_seisu_kuupaev" type="xsd:date">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Dokumendi seisu kuupäev</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="dokumendi_kehtivus" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Dokumendi_kehtivus" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>K - kehtiv, A - aegunud</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Dokumendi kehtivus</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="aruande_liik" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Aruande_liik" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>P - lõpparuanne, L- likvideerimisbilanss, V - vahearuanne/bilanss, A - aastaaruanne;  "" - põhikirjal aruande liik puudub</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Aruande liik</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="aruandeaasta" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Aruandeaasta" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Põhikirja aruandeaaasta on 0.</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Aruandeaasta</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="dokumendi_url" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Dokumendi_url" type="xsd:string">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Viide dokumendile</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotjaDokumentideLoetelu_v1">
        <xsd:sequence>
            <xsd:element name="keha" type="ar:ettevotja_dokumentide_loetelu_paring_v2" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotjaDokumentideLoetelu_v1Response">
        <xsd:sequence>
            <xsd:element name="paring" type="ar:ettevotja_dokumentide_loetelu_paring_v2" />
            <xsd:element name="keha" type="ar:ettevotja_dokumentide_loetelu_vastus_v2" />
        </xsd:sequence>
    </xsd:complexType>

<!-- wrapper declarations -->
    <xsd:element name="ettevotjaDokumentideLoetelu_v1" type="ar:ettevotjaDokumentideLoetelu_v1"/>
    <xsd:element name="ettevotjaDokumentideLoetelu_v1Response" type="ar:ettevotjaDokumentideLoetelu_v1Response"/>
<!-- /wrapper declarations -->

</xsd:schema>

<?xml version="1.0" encoding="UTF-8" ?> 
<xsd:schema
    targetNamespace="http://arireg.x-road.eu/producer/"
    elementFormDefault="qualified"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:swa="http://ws-i.org/profiles/basic/1.1/xsd"
    xmlns:sawsdl="http://www.w3.org/ns/sawsdl"
    xmlns:xrd="http://x-road.eu/xsd/xroad.xsd"
    xmlns:ar="http://arireg.x-road.eu/producer/">

    <xsd:complexType name="ettevotja_muudatused_tasuline_paring">
        <xsd:sequence>

            <xsd:element name="ariregister_kasutajanimi" type="xsd:string" nillable="true" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri kasutajanimi</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element name="ariregister_parool" type="xsd:string" nillable="true" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri parool</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="1" name="kuupaev" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kuupaev" type="xsd:date">
                <xsd:annotation>
                    <xsd:documentation>Näitab, millise kuupäeva kohta ettevõtja muudatusi päritakse.</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kuupäev</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="tulemuste_lk" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Tulemuste_lk" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Ettevõtja muudatuste lehekülje number. Vaikimisi 1</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Tulemuste lehekülje number</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotja_muudatused_tasuline_vastus">
        <xsd:sequence>

            <xsd:element minOccurs="0" maxOccurs="unbounded" name="ettevotja_muudatused" type="ar:ettevotja_muudatus">
                <xsd:annotation>
                    <xsd:documentation>Ettevõtjate muudatuste kirjed</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Muudatused</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="tulemuste_arv" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Tulemuste_arv" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Ettevõtjate muudatuste arv</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Arv</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotja_muudatus">
        <xsd:sequence>

            <xsd:element minOccurs="0" name="ariregistri_kood" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Maakohtu_poolt_registreeritud_isik_ariregistrikood" type="xsd:int">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri kood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="arinimi" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Arinimi" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Ärinimi</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Ärinimi</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="oiguslik_vorm" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Oiguslik_vorm" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Õiguslik vorm</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Õiguslik vorm</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="kandevalised_isikud" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kandevalised_isikud" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Kandeväline muudatus - muutusid kandevälised isikud</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kandevälised isikud</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="kandevalised_sidevahendid" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kandevalised_sidevahendid" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Kandeväline muudatus - muutusid kandevälised sidevahendid</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kandevälised sidevahendid</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            
            <xsd:element minOccurs="0" name="kandes_sidevahendid" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Kandega muudatus - muutusid sidevahendid</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kandes sidevahendid</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="kandevalised_tegevusalad" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kandevalised_tegevusalad" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Kandeväline muudatus - muutusid kandevälised tegevusalad</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kandevälised tegevusalad</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" maxOccurs="unbounded" name="kanded" type="ar:ettevotja_muudatuse_kanne">
                <xsd:annotation>
                    <xsd:documentation>Muudatus ariregistri kandes</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kanded</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotja_muudatuse_kanne">
        <xsd:sequence>

            <xsd:element minOccurs="0" name="registrikaardi_piirkond" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Registrikaardi_piirkond" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Registrikaardile märgitud piirkond</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Registrikaardi piirkond</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="registrikaardi_tyyp" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Registrikaardi_tyyp" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Registrikaardi tüüp</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Registrikaardi tüüp</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="registrikaardi_nr" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Registrikaardi_nr" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Registrikaardi number</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Registrikaardi number</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="kande_nr" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kande_nr" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Kande number</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kande number</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="kande_kuupaev" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kande_kuupaev" type="xsd:date">
                <xsd:annotation>
                    <xsd:documentation>Kande kuupaev</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kande kuupaev</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="kande_liik" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kande_liik" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Kande liik</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kande liik</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="kande_liik_tekst" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kande_liik_tekst" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Kande liik tekstina</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Kande liik tekstina</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="isikuandmed" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Isikuandmed" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Isikuandmed</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Isikuandmed</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotjaMuudatusedTasuline_v1">
        <xsd:sequence>
            <xsd:element name="keha" type="ar:ettevotja_muudatused_tasuline_paring" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevotjaMuudatusedTasuline_v1Response">
        <xsd:sequence>
            <xsd:element name="paring" type="ar:ettevotja_muudatused_tasuline_paring" />
            <xsd:element name="keha" type="ar:ettevotja_muudatused_tasuline_vastus" />
        </xsd:sequence>
    </xsd:complexType>

<!-- wrapper declarations -->
    <xsd:element name="ettevotjaMuudatusedTasuline_v1" type="ar:ettevotjaMuudatusedTasuline_v1"/>
    <xsd:element name="ettevotjaMuudatusedTasuline_v1Response" type="ar:ettevotjaMuudatusedTasuline_v1Response"/>
<!-- /wrapper declarations -->

</xsd:schema>

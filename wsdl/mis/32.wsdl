	<element name="paigaldis_probleemResponse" type="maa:paigaldis_probleemVastusType"/>
	<complexType name="paigaldis_probleemParingType">
		<annotation>
			<appinfo>
				<xrd:title>Paigaldiste seostamisel KPO objektidega tekkinud probleemide logi</xrd:title>
			</appinfo>
		</annotation>	
		<sequence>
			<choice>
				<element name="probleem_id" type="integer" minOccurs="0">
					<annotation>
						<appinfo>
							<xrd:title>Probleem ID</xrd:title>
							<xrd:notes>Alatest mitmendast logi kirjest päritakse</xrd:notes>
						</appinfo>
					</annotation>
				</element>
				<element name="algus" type="dateTime" minOccurs="0">
					<annotation>
						<appinfo>
							<xrd:title>Probleemi algus</xrd:title>
							<xrd:notes>Päritavate muudatuste alguskuupäev-kellaaeg (kujul: yyyy-mm-ddThh:min:ss)</xrd:notes>
						</appinfo>
					</annotation>
				</element>
			</choice>				
			<element name="lopp" type="dateTime" minOccurs="0">			
				<annotation>
					<appinfo>
						<xrd:title>Probleemi lõpp</xrd:title>
						<xrd:notes>Päritavate muudatuste lõppkuupäev-kellaaeg (kujul: yyyy-mm-ddThh:min:ss)</xrd:notes>									
					</appinfo>
				</annotation>
			</element>
			<element name="andmehaldaja" type="string" minOccurs="0">			
				<annotation>
					<appinfo>
						<xrd:title>Andmehaldaja</xrd:title>
						<xrd:notes>Andmehaldaja registrikood, kelle probleeme päritakse</xrd:notes>								
					</appinfo>
				</annotation>
			</element>			
			<element name="max_kirjeid" default="25" minOccurs="0">									
				<annotation>
					<appinfo>
						<xrd:title>Max kirjete arv</xrd:title>
						<xrd:notes>Maksimaalselt tagastavate kirjete arv ühe päringuga (vaikimisi 25, maksimaalselt 250)</xrd:notes>									
					</appinfo>
				</annotation>			
				<simpleType>
					<restriction base="integer">
						<minExclusive value="1"/>					
						<maxInclusive value="250"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>
	<complexType name="paigaldis_probleemVastusType">
		<annotation>
			<appinfo>
				<xrd:title>Paigaldiste seostamisel KPO objektidega tekkinud probleemide logi</xrd:title>
			</appinfo>
		</annotation>
		<sequence minOccurs="0" maxOccurs="unbounded">
			<element name="probleem">
				<complexType>
					<sequence>
						<element name="probleem_id" type="integer">
							<annotation>
								<appinfo>
									<xrd:title>Probleem Id</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="probleem_aeg" type="dateTime" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Aeg</xrd:title>
									<xrd:notes>Probleemi esinemise kuupäev ja kellaaeg</xrd:notes>
								</appinfo>							
							</annotation>
						</element>		
						<element name="probleemi_kirjeldus" type="string" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Kirjeldus</xrd:title>
									<xrd:notes>Probleemi kirjeldus</xrd:notes>
								</appinfo>														
							</annotation>
						</element>				
						<element name="paigaldise_id" type="integer">
							<annotation>
								<appinfo>
									<xrd:title>Paigaldise Id</xrd:title>
								</appinfo>														
							</annotation>						
						</element>
						<element name="paigaldise_regnr" type="string" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Paigaldise reg.nr</xrd:title>
								</appinfo>														
							</annotation>												
						</element>
						<element name="paigaldise_nimetus" type="string" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Paigaldise nimetus</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="andmehaldaja" type="string" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Andmehaldaja</xrd:title>
								</appinfo>
							</annotation>						
						</element>
						<element name="andmehaldaja_kood" type="string" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Andmehaldaja kood</xrd:title>
								</appinfo>
							</annotation>												
						</element>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
</schema>

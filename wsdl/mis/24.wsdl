								<appinfo>
									<xrd:title>Maakonna  kood</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="omavalitsus" type="maa:ehak" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Omavalitsus ( valla või linna kood) </xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="asustusyksus" type="maa:ehak" minOccurs="0">

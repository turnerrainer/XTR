								<appinfo>
									<xrd:title>KÜ lähiaadress</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="ky_asukoht" type="string" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Aadress teksti kujul </xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="maakond" type="maa:ehak" minOccurs="0">

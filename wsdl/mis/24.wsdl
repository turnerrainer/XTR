									<xrd:title>Tsentroid x koordinaat</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="tsentroid_y" type="decimal" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title> Tsentroid y koordinaat</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="allkirja_kuupaev" type="dateTime" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>KÜ versiooni allkirjastamise kuupäev</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="sulgemise_kuupaev" type="dateTime" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>KÜ sulgemise kuupäev/aeg</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="kinnistusregistriosa" type="string" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Kinnistu registriosa number</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="koosseisu_kuupaev" type="date" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Kinnistu koosseisu arvamise kuupäev</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="koosseisust_kuupaev" type="date" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Kinnistu koosseisust väljaarvamise kuupäev</xrd:title>
								</appinfo>
							</annotation>
						</element>
						<element name="url" type="anyURI" minOccurs="0">
							<annotation>
								<appinfo>
									<xrd:title>Näita kaardil</xrd:title>
								</appinfo>
							</annotation>
						</element>
					</sequence>
					<attribute name="id" type="ID">
						<annotation>
							<appinfo>
								<xrd:title>Päringu kirje unikaalne identifikaator</xrd:title>
							</appinfo>
						</annotation>
					</attribute>
				</complexType>
			</element>
      <element name="fault" minOccurs="0">
        <complexType>
          <sequence>
            <element name="faultCode" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kood</xrd:title>
                </appinfo>
              </annotation>
            </element>
            <element name="faultString" type="string">
              <annotation>
                <appinfo>
                  <xrd:title>Vea kirjeldus</xrd:title>
                </appinfo>
              </annotation>
            </element>
          </sequence>
        </complexType>
      </element>
    </sequence>
	</complexType>

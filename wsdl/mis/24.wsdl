  <element name="kyasukoht" type="maa:kyasukohtParingType"/>
	<element name="kyasukohtResponse" type="maa:kyasukohtVastusType"/>
	<complexType name="kyasukohtParingType">
		<annotation>
			<appinfo>
				<xrd:title>Katastriüksuse päring asukoha järgi</xrd:title>
			</appinfo>
		</annotation>
		<sequence>
			<element name="maakond" type="maa:ehak">
				<annotation>
					<appinfo>
						<xrd:title>Maakond</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="omavalitsus" type="maa:ehak">
				<annotation>
					<appinfo>
						<xrd:ref>maakond</xrd:ref>
						<xrd:title>Omavalitsus</xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="asustusyksus" type="maa:ehak" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:ref>omavalitsus</xrd:ref>
						<xrd:title>Asustusüksus </xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="ky_nimi" type="string" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:wildcard>*?</xrd:wildcard>
						<xrd:title>Katastriüksuse lähiaadress </xrd:title>
					</appinfo>
				</annotation>
			</element>
			<element name="ky_max" type="maa:ky_arvType" default="10" minOccurs="0">
				<annotation>
					<appinfo>
						<xrd:title>Maksimaalne vastuste arv</xrd:title>
					</appinfo>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="kyasukohtVastusType">

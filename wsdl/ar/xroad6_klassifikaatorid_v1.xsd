<?xml version="1.0" encoding="UTF-8" ?> 
<xsd:schema
    targetNamespace="http://arireg.x-road.eu/producer/"
    elementFormDefault="qualified"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:swa="http://ws-i.org/profiles/basic/1.1/xsd"
    xmlns:sawsdl="http://www.w3.org/ns/sawsdl"
    xmlns:xrd="http://x-road.eu/xsd/xroad.xsd"
    xmlns:ar="http://arireg.x-road.eu/producer/">

    <xsd:complexType name="klassifikaatorid_paring">
        <xsd:sequence>

            <xsd:element name="ariregister_kasutajanimi" type="xsd:string" nillable="true" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri kasutajanimi</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element name="ariregister_parool" type="xsd:string" nillable="true" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri parool</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="klassifikaator" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Klassifikaator" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>Klassifikaatori kood (kui puudub, siis tagastatakse kõik klassifikaatorid)</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Klassifikaatori kood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element minOccurs="0" name="keel" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Keel" type="xsd:string">
                <xsd:annotation>
                    <xsd:documentation>est (vaikimisi), eng</xsd:documentation>
                    <xsd:appinfo>
                        <xrd:title>Registrikaardi keel</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="klassifikaatorid_vastus">
        <xsd:sequence>
            <xsd:element minOccurs="0" maxOccurs="unbounded" name="klassifikaator" type="ar:klassifikaator"></xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="klassifikaator">
        <xsd:sequence>

            <xsd:element name="klassifikaatori_kood" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Klassifikaatori_kood" type="xsd:string">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Klassifikaatori kood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element name="klassifikaatori_nimetus" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Klassifikaatori_nimetus" type="xsd:string">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Klassifikaatori nimetus</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

            <xsd:element name="klassifikaatori_vaartused" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Klassifikaatori_vaartused" type="ar:klassifikaatori_vaartused">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Klassifikaatori väärtused</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>

        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="klassifikaatori_vaartused">
        <xsd:sequence>
            <xsd:element minOccurs="0" maxOccurs="unbounded" name="klassifikaatori_vaartus" type="ar:klassifikaatori_vaartus"></xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="klassifikaatori_vaartus">
        <xsd:sequence>
            <xsd:element name="klassifikaatori_vaartuse_kood" type="xsd:string"></xsd:element>
            <xsd:element name="klassifikaatori_vaartuse_nimetus" type="xsd:string"></xsd:element>
            <xsd:element minOccurs="0" name="klassifikaatori_vaartuse_algus_kpv" type="xsd:date"></xsd:element>
            <xsd:element minOccurs="0" name="klassifikaatori_vaartuse_lopp_kpv" type="xsd:date"></xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="klassifikaatorid_v1">
        <xsd:sequence>
            <xsd:element name="keha" type="ar:klassifikaatorid_paring" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="klassifikaatorid_v1Response">
        <xsd:sequence>
            <xsd:element name="paring" type="ar:klassifikaatorid_paring" />
            <xsd:element name="keha" type="ar:klassifikaatorid_vastus" />
        </xsd:sequence>
    </xsd:complexType>

<!-- wrapper declarations -->
    <xsd:element name="klassifikaatorid_v1" type="ar:klassifikaatorid_v1"/>
    <xsd:element name="klassifikaatorid_v1Response" type="ar:klassifikaatorid_v1Response"/>
<!-- /wrapper declarations -->

</xsd:schema>

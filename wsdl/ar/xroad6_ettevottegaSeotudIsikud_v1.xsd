<?xml version="1.0" encoding="UTF-8" ?> 
<xsd:schema
    targetNamespace="http://arireg.x-road.eu/producer/"
    elementFormDefault="qualified"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:swa="http://ws-i.org/profiles/basic/1.1/xsd"
    xmlns:sawsdl="http://www.w3.org/ns/sawsdl"
    xmlns:xrd="http://x-road.eu/xsd/xroad.xsd"
    xmlns:ar="http://arireg.x-road.eu/producer/">

    <xsd:complexType name="ettevottega_seotud_isikud_paring">
        <xsd:sequence>
            <xsd:element name="ariregister_sessioon" type="xsd:string" nillable="true" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri sessioon</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="keel" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Klassifikaatorite tõlgete keel</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="vastupidi" type="xsd:boolean" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Kui True, siis otsitakse vastupidi seoseid - s.t. isikuga seotud ettevõtteid. (vaikimisi False)</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="ariregister_valjundi_formaat" type="xsd:string" nillable="true" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri väljundi formaat - "json", "xml" (vaikimisi)</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="ariregistri_kood" type="xsd:integer" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Maakohtu_poolt_registreeritud_isik_ariregistrikood">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Äriregistri kood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="fyysilise_isiku_eesnimi" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Seotud füüsilise isiku eesnimi</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="fyysilise_isiku_perekonnanimi" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Seotud füüsilise isiku perekonnanimi</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="fyysilise_isiku_synniaeg" type="xsd:date" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Seotud füüsilise isiku sünniaeg</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="fyysilise_isiku_kood" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Seotud füüsilise isiku isikukood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevottega_seotud_isikud_vastus">
        <xsd:sequence>
            <xsd:element minOccurs="0" maxOccurs="unbounded" name="seosed" type="ar:seos">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Ettevõte-isik seos</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="seos">
        <xsd:sequence>
            <xsd:element name="isiku_tyyp" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Isiku_rollist_tulenevad_andmed_isiku_tuup">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Isiku tüüp</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="isiku_roll" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Isiku_roll_roll">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Isiku roll</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="isiku_roll_tekstina" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Isiku_roll_tekstina">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Isiku roll tekstina</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="eesnimi" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Registrikaardil_oleva_isiku_andmed">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Eesnimi</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="nimi_arinimi" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Registrikaardil_oleva_isiku_andmed">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Perekonna- või ärinimi</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="isikukood_registrikood" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Registrikaardil_oleva_isiku_andmed">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Isikukood või registrikood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="synniaeg" type="xsd:date" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Isiku sünnikuupäev</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="valis_kood" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Registrikaardil_oleva_isiku_andmed">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Väliskood</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="valis_kood_riik" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Registrikaardil_oleva_isiku_andmed">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Väliskoodi riik</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="algus_kpv" type="xsd:date" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kehtivus_alguse_kuupaev">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Alguskuupäev</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="lopp_kpv" type="xsd:date" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kehtivuse_loppkuupaev">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Lõppkuupäev</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="osaluse_protsent" type="xsd:decimal" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kaardivaline_isik_ettevotte_osaluse_protsent">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Osaluse protsent</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="osaluse_suurus" type="xsd:decimal" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kaardivaline_isik_ettevotte_osaluse_suurus">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Osaluse suurus</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="osaluse_valuuta" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kaardivaline_isik_ettevotte_osaluse_valuuta">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Osaluse valuuta</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="aadress_riik" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kaardivalise_isiku_andmed">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Aadress: riik</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="aadress_riik_tekstina" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Kaardivalise_isiku_andmed">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Aadressi riik tekstina</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="kontrolli_teostamise_viis" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Kontrolli teostamise viis</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="kontrolli_teostamise_viis_tekstina" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Kontrolli teostamise viis tekstina</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="staatus" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Staatus_staatus">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Ettevõtte staatus</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="staatus_tekstina" type="xsd:string" minOccurs="0" sawsdl:modelReference="https://riha.eesti.ee/riha/onto/ettevotlus.ariregister/2010/r2#Staatus_staatus_tekstina">
                <xsd:annotation>
                    <xsd:appinfo>
                        <xrd:title>Ettevõtte staatus tekstina</xrd:title>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevottegaSeotudIsikud_v1">
        <xsd:sequence>
            <xsd:element name="keha" type="ar:ettevottega_seotud_isikud_paring" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ettevottegaSeotudIsikud_v1Response">
        <xsd:sequence>
            <xsd:element name="paring" type="ar:ettevottega_seotud_isikud_paring" />
            <xsd:element name="keha" type="ar:ettevottega_seotud_isikud_vastus" />
        </xsd:sequence>
    </xsd:complexType>

<!-- wrapper declarations -->
    <xsd:element name="ettevottegaSeotudIsikud_v1" type="ar:ettevottegaSeotudIsikud_v1"/>
    <xsd:element name="ettevottegaSeotudIsikud_v1Response" type="ar:ettevottegaSeotudIsikud_v1Response"/>
<!-- /wrapper declarations -->

</xsd:schema>

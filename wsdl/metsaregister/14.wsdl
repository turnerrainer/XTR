					<xs:element name="teatiseGeomeetria" type="gml:MultiPolygonType"/>
					<xs:choice>
						<xs:element name="teatisRaie">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="tooliik" type="mets:koodType"/>
									<xs:element name="raiutavMaht" type="mets:Integer4Type"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="teatisKahjustus">
							<xs:complexType>
								<xs:sequence>
									<xs:element minOccurs="0" name="kPohjused">
										<xs:complexType>
											<xs:sequence>
												<xs:element maxOccurs="3" minOccurs="1" name="kPohjus" type="mets:koodType">
													<xs:annotation>
														<xs:documentation>Kahjustuse põhjus. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 16</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element minOccurs="0" name="kPuuliigid">
										<xs:complexType>
											<xs:sequence>
												<xs:element maxOccurs="3" minOccurs="0" name="kPuuliik" type="mets:koodType">
													<xs:annotation>
														<xs:documentation>Kahjustatud puuliik. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 9</xs:documentation>
													</xs:annotation>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:choice>
					<xs:element name="teatisNr" type="mets:teatisNrType"/>
					<xs:element name="olek" type="mets:koodType"/>
					<xs:element minOccurs="0" name="otsusKuup" type="xs:date">
						<xs:annotation>
							<xs:documentation>Otsuse kuupäev. Peab olema täidetud, kui olek on 6, st menetletud.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="teatiseOtsus" type="mets:teatiseOtsusEnum"/>
					<xs:element minOccurs="0" name="otsusePohjendus" type="xs:string"/>
					<xs:element minOccurs="0" name="mkeNr" type="mets:mkeNrType"/>
					<xs:element minOccurs="0" name="tyhistatavTeatis" type="mets:teatisNrType"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- MKE andmete päring -->
	<xs:complexType name="mkeAndmedParing">
		<xs:sequence>
			<xs:element minOccurs="0" name="vastuseidParingus" type="xs:int"/>
			<xs:element minOccurs="0" name="lehekyljeNr" type="xs:int"/>
			<xs:choice>
				<xs:element name="olekuMuudatused">
					<xs:complexType>
						<xs:sequence>
							<xs:element minOccurs="0" name="olekud">
								<xs:complexType>
									<xs:sequence>
										<xs:element maxOccurs="unbounded" name="aktiOlek" type="mets:aktiOlekType"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="kuupaevAlgus" type="xs:date"/>
							<xs:element minOccurs="0" name="kuupaevLopp" type="xs:date"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="mked">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="mkeNr" type="mets:mkeNrType"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>

	<!-- MKE andmete vastus -->
	<xs:complexType name="mkeAndmedVastus">
		<xs:sequence>
			<xs:element name="vastuseidKokku" type="xs:int"/>
			<xs:element name="vastuseidParingus" type="xs:int"/>
			<xs:element name="lehekyljeNr" type="xs:int"/>
			<xs:element minOccurs="0" name="mkeAktid">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="mkeAkt" type="mets:mkeAkt"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="yldineViga" type="mets:viga"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="mkeAkt">
		<xs:sequence>
			<xs:element name="aktiNr" type="mets:mkeNrType"/>
			<xs:element name="olek" type="mets:aktiOlekType"/>
			<xs:element minOccurs="0" name="eelnouAvaldAeg" type="xs:dateTime"/>
			<xs:element minOccurs="0" name="otsusKuup" type="xs:date">
				<xs:annotation>
					<xs:documentation>Akti kinnitamise  kuupäev.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kehtivKuni" type="xs:date">
				<xs:annotation>
					<xs:documentation>Otsuse kehtivuse lõppaeg.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="ekspertiisiTegija" type="xs:string">
				<xs:annotation>
					<xs:documentation>MKE menetleja ees – ja perekonnanimi</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="hinnangSeisundile" type="xs:string">
				<xs:annotation>
					<xs:documentation>Metsa seisundi hinnang</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="tingimusedSoovitused" type="xs:string">
				<xs:annotation>
					<xs:documentation>Tingimused ja soovitused</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="metsakaitseAbinoud" type="xs:string">
				<xs:annotation>
					<xs:documentation>Üldised metsakaitse abinõud</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="markused" type="xs:string">
				<xs:annotation>
					<xs:documentation>Aktile lisatud märkused</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="mkeAktiRead">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="mkeAktiRida" type="mets:mkeAktiRida"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element minOccurs="0" name="vead">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="viga" type="mets:viga"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="mkeAktiRida">
		<xs:sequence>
			<xs:element minOccurs="0" name="katastriNr" type="mets:katastriNrType"/>
			<xs:element minOccurs="0" name="kvartaliNr" type="mets:kvartaliNrType"/>
			<xs:element minOccurs="1" name="eraldiseNr" type="mets:erldiseNrType"/>
			<xs:element name="alaGeomeetria" type="gml:MultiPolygonType"/>
			<xs:element minOccurs="0" name="taiusTerve" type="xs:int">
				<xs:annotation>
					<xs:documentation>Kahjustatud ala tervete puude täius (%)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="puudeArvTerve" type="xs:int">
				<xs:annotation>
					<xs:documentation>Tervete puude arv tk/ha</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kahjustatudPuuliik" type="xs:string">
				<xs:annotation>
					<xs:documentation>Kahjustatud puuliigi kood</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kahjustuseProtsent" type="xs:int">
				<xs:annotation>
					<xs:documentation>Kahjustuse % kokku</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="ulukikahjuProtsent" type="xs:int">
				<xs:annotation>
					<xs:documentation>Sh ulukikahjustuse %</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kahjustusPuudub" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Tunnus kahjustuse puudumise kohta.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kahjustajad">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="4" minOccurs="1" name="kahjustaja" type="mets:koodType">
							<xs:annotation>
								<xs:documentation>Kahjustuse põhjus. Väärtus leidub klassifikaatoris. MK juhendi lisa 16</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element minOccurs="0" name="tooLiik" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Soovitatava raie liik (töö kood)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="soovitatavRaiePindala" type="mets:eraldisePindalaType">
				<xs:annotation>
					<xs:documentation>Soovitatava raie pindala (ha)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="raiemaht" type="mets:Integer6Type">
				<xs:annotation>
					<xs:documentation>Soovitatav raiemaht</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="ehNr" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	
	<!-- Metsauuenduse tähtaja pikendamistaotluse esitamine -->
	<xs:complexType name="muPikendamineParing">
		<xs:annotation>
			<xs:documentation>Metsauuenduse tähtaja pikendamise taotluse esitamine</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="muTaotlusYksused">
				<xs:annotation>
					<xs:documentation>MU tähtaja pikendamise taotlused kinnistute või RMK metskondade kaupa. Kohustuslik esitada vähemalt ühe üksuse taotlus(t)e andmed.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="muTaotlusYksus" type="mets:muTaotlusYksusEsitamine"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="muTaotlusYksusEsitamine">
		<xs:complexContent>
			<xs:extension base="mets:yksusAndmedAbstact">
				<xs:sequence>
					<xs:element name="muTaotlused">
						<xs:complexType>
							<xs:sequence>
								<xs:element maxOccurs="unbounded" name="muTaotlus" type="mets:muTaotlusEsitamine"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="muTaotlusEsitamine">
		<xs:sequence>
			<xs:element name="vKood" type="mets:ehakKoodType"/>
			<xs:element name="mKood" type="mets:ehakKoodType"/>
			<xs:element name="omanikuKood" type="mets:ikoodType"/>
			<xs:element name="omanikuNimi" type="mets:nimetusType"/>
			<xs:element name="omanikJuriidiline" type="xs:boolean"/>
			<xs:element name="omanikValismaalane" type="xs:boolean"/>
			<xs:choice>
				<xs:element minOccurs="0" name="volitatudIsik">
					<xs:complexType>
						<xs:sequence>
							<xs:element minOccurs="0" name="volitatudIsikuKood" type="mets:isikukoodType"/>
							<xs:element minOccurs="0" name="volitatudIsikuNimi" type="mets:nimetusType"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element minOccurs="0" name="kasutusvaldaja">
					<xs:complexType>
						<xs:sequence>
							<xs:element minOccurs="0" name="kasutusvaldajaKood" type="mets:isikukoodType"/>
							<xs:element minOccurs="0" name="kasutusvaldajaNimi" type="mets:nimetusType"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
			<xs:element minOccurs="0" name="aadress" type="mets:aadressType"/>
			<xs:element minOccurs="0" name="postiindeks" type="mets:indeksType"/>
			<xs:element minOccurs="0" name="adsOid" type="mets:adsoidType">
				<xs:annotation>
					<xs:documentation>Kohustuslik, kui on sisestatud kontaktaadress(aadress). Peab vastama aadressile.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="telefon" type="mets:Long10Type"/>
			<xs:element minOccurs="0" name="epost" type="mets:epostType"/>
			<xs:element minOccurs="1" name="katastriNr" type="mets:katastriNrType">
				<xs:annotation>
					<xs:documentation>Hetkel kehtiv katastritunnus kujul xxxxx:xxx:xxxx</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="1" name="raieDokument" type="mets:raieDokument"/>
			<xs:element minOccurs="1" name="muTahtajaLiik" type="xs:string">
				<xs:annotation>
					<xs:documentation>Pikendatava tähtaja liik. Väärtused MU (metsa uuenenemise tähtaeg), UVR (uuendamisvõtete rakendamise tähtaeg)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice>
				<xs:element minOccurs="0" name="muPikendamisePohjus" type="mets:koodType">
					<xs:annotation>
						<xs:documentation>Metsauuendamise tähtaja pikendamise põhjus. Väärtus peab leiduma klassifikaatoris.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element minOccurs="0" name="uvrPikendamisePohjus" type="mets:koodType">
					<xs:annotation>
						<xs:documentation>Metsa uuendamisvõtete tähtaja pikendamise põhjus. Väärtus peab leiduma klassifikaatoris.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<xs:element minOccurs="1" name="uusTahtaeg" type="xs:date"/>
			<xs:element minOccurs="0" name="selgitus" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="raieDokument">
		<xs:annotation>
			<xs:documentation>Taotluse aluseks olev raiedokument</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="mets:eraldisAndmedAbstract">
				<xs:sequence>
					<xs:element minOccurs="0" name="teatisNr" type="mets:teatisNrType"/>
					<xs:element minOccurs="0" name="mkeNr" type="mets:mkeNrType"/>
					<xs:element name="teatisePindala" type="mets:eraldisePindalaType"/>
					<xs:element name="tooliik" type="mets:koodType"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- Metsauuenduse pikendamise taotluse päringu vastus -->
	<xs:complexType name="muPikendamineVastus">
		<xs:sequence>
			<xs:element minOccurs="0" name="yldineStaatus" type="mets:staatusEnum">
				<xs:annotation>
					<xs:documentation>Üldine staatus. Võimalikud väärtused OK/NOK</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="muTaotlused">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="muTaotlus" type="mets:muTaotlusVastus"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="muTaotlusVastus">
		<xs:sequence>
			<xs:element minOccurs="1" name="raieDokument" type="mets:raieDokument"/>
			<xs:element name="staatus" type="mets:staatusEnum"/>
			<xs:element minOccurs="0" name="muTaotlusNr" type="mets:muTaotlusNrType">
				<xs:annotation>
					<xs:documentation>MU taotluse registreeringu nr MR-s</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="vead">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="viga" type="mets:viga"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- Metsauuenduse taotluse otsuse pärimine -->
	<xs:complexType name="muTaotlusOtsusParing">
		<xs:sequence>
			<xs:element minOccurs="0" name="kirjeidVastuses" type="xs:int"/>
			<xs:element minOccurs="0" name="lehekyljeNr" type="xs:int"/>
			<xs:choice>
				<xs:element name="olekuMuudatused">
					<xs:complexType>
						<xs:sequence>
							<xs:element minOccurs="0" name="olekud">
								<xs:complexType>
									<xs:sequence>
										<xs:element maxOccurs="unbounded" name="olek" type="mets:koodType">
											<xs:annotation>
												<xs:documentation>Taotluse olek. Võimalikud väärtused 2 - menetluses, 3 - kinnitatud, 4 - arhiveeritud.</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="kuupaevAlgus" type="xs:date"/>
							<xs:element minOccurs="0" name="kuupaevLopp" type="xs:date"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="muTaotlused">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="muTaotlusNr" type="mets:muTaotlusNrType"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>

	<!-- Metsauuenduse taotluse otsuse päringu vastus -->
	<xs:complexType name="muTaotlusOtsusVastus">
		<xs:sequence>
			<xs:element name="taotlusiKokku" type="xs:int"/>
			<xs:element name="kirjeidVastuses" type="xs:int"/>
			<xs:element name="lehekyljeNr" type="xs:int"/>
			<xs:element minOccurs="0" name="muTaotlused">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="muTaotlus" type="mets:muOtsusVastus"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="yldineViga" type="mets:viga"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="muOtsusVastus">
		<xs:sequence>
			<xs:element name="muTaotlusNr" type="mets:muTaotlusNrType"/>
			<xs:element name="olek" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Taotluse olek. Võimalikud väärtused 2 - menetluses, 3 - kinnitatud, 4 - arhiveeritud.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="otsusKuup" type="xs:date">
				<xs:annotation>
					<xs:documentation>Otsuse kuupäev</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="muTaotlusOtsus" type="mets:muTaotlusOtsusEnum"/>
			<xs:element minOccurs="0" name="uusTahtaeg" type="xs:date">
				<xs:annotation>
					<xs:documentation>Otsusega kinnitatud uus tähtaeg. Võib erineda taotletud tähtajast.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="otsusePohjendus" type="xs:string"/>
			<xs:element minOccurs="0" name="vead">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="viga" type="mets:viga"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- Lihttüübid -->
	<xs:simpleType name="aadressType">
		<xs:restriction base="mets:String250Type"/>
	</xs:simpleType>

	<xs:simpleType name="adsoidType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="15"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="diameeterType">
		<xs:restriction base="mets:Integer3Type"/>
	</xs:simpleType>

	<xs:simpleType name="ehakKoodType">
		<xs:restriction base="mets:Integer4Type"/>
	</xs:simpleType>

	<xs:simpleType name="epostType">
		<xs:restriction base="xs:string">
			<xs:pattern value="\w[\w-]*(\.[\w\-]+)*@\w[\w\-]*(\.[\w]+)+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="eraldisePindalaType">
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="7"/>
			<xs:fractionDigits value="2"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="erldiseNrType">
		<xs:restriction base="mets:Integer3Type"/>
	</xs:simpleType>

	<xs:simpleType name="ikoodType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="indeksType">
		<xs:restriction base="xs:int">
			<xs:totalDigits value="5"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="isikukoodType">

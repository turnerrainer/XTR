<?xml version="1.0" encoding="UTF-8"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:sch0="http://metsaregister.x-road.eu" xmlns:sch1="http://rm-v6.x-road.eu/treasury/customer" xmlns:sch2="http://dumonitor.x-road.eu/producer" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://metsaregister.x-road.eu" xmlns:xroad="http://x-road.eu/xsd/xroad.xsd" targetNamespace="http://metsaregister.x-road.eu">
  <wsdl:types>
    <xs:schema xmlns:gml="http://www.opengis.net/gml" xmlns:mets="http://metsaregister.x-road.eu" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://metsaregister.x-road.eu"><xs:import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>
	<xs:import namespace="http://www.opengis.net/gml" schemaLocation="http://schemas.opengis.net/gml/3.1.1/base/gml.xsd"/>
	<xs:import namespace="http://www.w3.org/2005/05/xmlmime" schemaLocation="https://www.w3.org/2005/05/xmlmime"/>
	<xs:import namespace="http://x-road.eu/xsd/xroad.xsd" schemaLocation="http://x-road.eu/xsd/xroad.xsd"/>

	<xs:element name="eraldisEsitamine" type="mets:eraldisEsitamineParing"/>
	
	<xs:element name="eraldisEsitamineResponse" type="mets:eraldisEsitamineVastus"/>

	<xs:element name="eraldisStaatus" type="mets:eraldisStaatusParing"/>
	<xs:element name="eraldisStaatusResponse" type="mets:eraldisStaatusVastus"/>

	<xs:element name="eraldisKustutamine" type="mets:eraldisKustutamineParing"/>
	<xs:element name="eraldisKustutamineResponse" type="mets:eraldisKustutamineVastus"/>

	<xs:element name="teatisEsitamine" type="mets:teatisEsitamineParing"/>
	
	<xs:element name="teatisEsitamineResponse" type="mets:teatisEsitamineVastus"/>

	<xs:element name="teatisOlek" type="mets:teatisOlekParing"/>
	
	<xs:element name="teatisOlekResponse" type="mets:teatisOlekVastus"/>

	<xs:element name="teatisRiigiloivJaak" type="mets:teatisRiigiloivParing"/>
	
	<xs:element name="teatisRiigiloivJaakResponse" type="mets:teatisRiigiloivVastus"/>

	<xs:element name="teatisTyhistamine" type="mets:teatisTyhistamineParing"/>
	
	<xs:element name="teatisTyhistamineResponse" type="mets:teatisTyhistamineVastus"/>

	<xs:element name="yksusEraldised" type="mets:yksusEraldisedParing"/>
	<xs:element name="yksusEraldisedResponse" type="mets:yksusEraldisedVastus"/>

	<xs:element name="teatisAllalaadimine" type="mets:teatisAllalaadimineVastus"/>

	<xs:element name="mkeAndmed" type="mets:mkeAndmedParing"/>
	
	<xs:element name="mkeAndmedResponse" type="mets:mkeAndmedVastus"/>

	<xs:element name="muPikendamine" type="mets:muPikendamineParing"/>
	
	<xs:element name="muPikendamineResponse" type="mets:muPikendamineVastus"/>

	<xs:element name="muTaotlusOtsus" type="mets:muTaotlusOtsusParing"/>
	
	<xs:element name="muTaotlusOtsusResponse" type="mets:muTaotlusOtsusVastus"/>

	<!-- Eraldis esitamine -->
	<xs:complexType name="eraldisEsitamineParing">
		<xs:annotation>
			<xs:documentation>Esitatavad inventeerimisandmed</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ettevote" type="mets:registrikoodType">
				<xs:annotation>
					<xs:documentation>Metsakorraldusettevõte registrikood</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="epost" type="mets:epostType">
				<xs:annotation>
					<xs:documentation>E-post millele saadetakse teavitusi esitatud eraldiste kohta.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="yksused">
				<xs:annotation>
					<xs:documentation>Eraldiste andmed kinnistute või RMK metskondade kaupa. Kohustuslik esitada vähemalt ühe üksuse eraldis(t)e andmed.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="yksus" type="mets:yksusEsitamine"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="yksusEsitamine">
		<xs:complexContent>
			<xs:extension base="mets:yksusAndmedAbstact">
				<xs:sequence>
					<xs:element minOccurs="0" name="dokument" type="mets:manus"/>
					<xs:element name="eraldised">
						<xs:annotation>
							<xs:documentation>Eraldiste inventeerimise andmed</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
								<xs:element maxOccurs="unbounded" name="eraldis" type="mets:eraldisEsitamine"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType abstract="true" name="yksusAndmedAbstact">
		<xs:sequence>
			<xs:element minOccurs="0" name="kinnistuNimi" type="mets:nimetusType">
				<xs:annotation>
					<xs:documentation>Kinnistu nimi.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice>
				<xs:element minOccurs="0" name="kinnistuNr" type="mets:kinnistuNrType">
					<xs:annotation>
						<xs:documentation>Kinnistu number. Erametsa korral on vaja täita. Kohustuslik, kui metskond ei ole täidetud.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element minOccurs="0" name="metskond" type="mets:nimetusType">
					<xs:annotation>
						<xs:documentation>Metskond. RMK täidab metskonna välja. Kohustuslik, kui kinnistu nr ei ole täidetud.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="eraldisEsitamine">
		<xs:complexContent>
			<xs:extension base="mets:eraldisAndmedAbstract">
				<xs:sequence>
					<xs:element name="inventKuup" type="xs:date">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Inventeerimise kuupäev</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="vKood" type="mets:ehakKoodType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Valla või linna kood. EHAK kood</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="mKood" type="mets:ehakKoodType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Maakonna kood. EHAK kood</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="takseerija" type="mets:isikukoodType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Metsakorraldaja/takseerija isikukood</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="pindala" type="mets:eraldisePindalaType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Eraldise pindala</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="kuivendatud" type="mets:tunnusType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Kuivenduse tunnus. Lubatud väärtused 1 ja 0 (1 - kuivendatud). MK juhendi lisa 6</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="kasvukoht" type="mets:koodType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Kasvukohatüüp. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="peapuuliik" type="mets:koodType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 14</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="korgusIndeks" type="mets:korgusType">
						<xs:annotation>
							<xs:documentation>Kõrgusindeks. MK juhendi lisa 10</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="boniteet" type="mets:koodType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Boniteediklass. Väärtus peab leiduma klassifikaatoris. MK juhendi lisad 2 ja 10. Edastatakse kood kujul 0,1,2 jne</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="tuleohuklass" type="mets:koodType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Tuleohuklass. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 4</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="arenguklass" type="mets:koodType">
						<xs:annotation>
							<xs:documentation>Kohustuslik. Arenguklass. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 3</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="kkVanus" type="mets:vanusType">
						<xs:annotation>
							<xs:documentation>Kaalutud keskmine vanus. Metsa majandamise eeskiri §3</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="kkRaievanus" type="mets:vanusType">
						<xs:annotation>
							<xs:documentation>Kaalutud keskmine raievanus. Metsa majandamise eeskiri §3</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="juurdekasv" type="mets:juurdekasvType">
						<xs:annotation>
							<xs:documentation>Tagavara juurdekasv. MK juhendi lisa 12</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="rPindala1" type="mets:rpindalaType">
						<xs:annotation>
							<xs:documentation>Esimese rinde rinnaspindala.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="taius1" type="mets:taiusType">
						<xs:annotation>
							<xs:documentation>Esimese rinde täius. MK juhendi lisa 11 punkt 2</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="rPindala2" type="mets:rpindalaType">
						<xs:annotation>
							<xs:documentation>Teise rinde rinnaspindala</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="taius2" type="mets:taiusType">
						<xs:annotation>
							<xs:documentation>Teise rinde täius. MK juhendi lisa 11 punkt 2</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="tagavara1Ha" type="mets:tagavaraType">
						<xs:annotation>
							<xs:documentation>Esimese rinde hektaritagavara. MK juhendi lisa 11 punkt 1</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="tagavara2Ha" type="mets:tagavaraType">
						<xs:annotation>
							<xs:documentation>Teise rinde hektaritagavara. MK juhendi lisa 11 punkt 1</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="tagavaraYHa" type="mets:tagavaraType">
						<xs:annotation>
							<xs:documentation>Üksikpuude rinde hektaritagavara. MK juhendi lisa 11 punkt 1</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="puudeArv" type="mets:puudeArvType">
						<xs:annotation>
							<xs:documentation>Puude arv. Täidetakse arenguklassi S ja N korral hektari kohta</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="jPuudeArv" type="mets:puudeArvType">
						<xs:annotation>
							<xs:documentation>Järelkasvu puude arv</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="yPuudeArv" type="mets:puudeArvType">
						<xs:annotation>
							<xs:documentation>Üksikpuude arv</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="tagavaraS" type="mets:tagavaraType">
						<xs:annotation>
							<xs:documentation>Surnud puude hektaritagavara</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="tagavaraL" type="mets:tagavaraType">
						<xs:annotation>
							<xs:documentation>Lamapuidu hektaritagavara</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="prLiitus" type="mets:protsentType">
						<xs:annotation>
							<xs:documentation>Põõsarinde liitus</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="geomeetria" type="gml:MultiPolygonType">
						<xs:annotation>
							<xs:documentation>Eralduse ruumikuju koordinaadid GML formaadis</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="elemendid">
						<xs:complexType>
							<xs:sequence>
								<xs:element maxOccurs="unbounded" name="element" type="mets:eraldisElement"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" name="isearasused">
						<xs:complexType>
							<xs:sequence>
								<xs:element maxOccurs="unbounded" name="isearasus" type="mets:koodType">
									<xs:annotation>
										<xs:documentation>Iseärasuse kood. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 9</xs:documentation>
									</xs:annotation>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" name="kahjustused">
						<xs:complexType>
							<xs:sequence>
								<xs:element maxOccurs="unbounded" name="kahjustus" type="mets:eraldisKahjustus"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" name="tood">
						<xs:complexType>
							<xs:sequence>
								<xs:element maxOccurs="unbounded" name="too" type="mets:eraldisToo"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" name="tekst" type="xs:string">
						<xs:annotation>
							<xs:documentation>Reserveeritud tuleviku vajaduste jaoks</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType abstract="true" name="eraldisAndmedAbstract">
		<xs:sequence>
			<xs:element minOccurs="0" name="katastriNr" type="mets:katastriNrType">
				<xs:annotation>
					<xs:documentation>Katastritunnus kujul xxxxx:xxx:xxxx. Kohustuslik, kui esitaja ei ole RMK. RMK puhul soovituslik.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kvartaliNr" type="mets:kvartaliNrType">
				<xs:annotation>
					<xs:documentation>Kvartali number</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="1" name="eraldiseNr" type="mets:erldiseNrType">
				<xs:annotation>
					<xs:documentation>Kohustuslik. Eraldise number</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="eraldisElement">
		<xs:sequence>
			<xs:element name="rinne" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Kohustuslik. Väärtus peab leiduma klassifikaatoris</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="puuliik" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Kohustuslik. Väärtus peab leiduma klassifikaatoris</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="paritolu" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Väärtus peab leiduma klassifikaatoris
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="osakaal" type="mets:protsentType">
				<xs:annotation>
					<xs:documentation>Osakaal</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="vanus" type="mets:vanusType">
				<xs:annotation>
					<xs:documentation>Vanus</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="synniaasta" type="xs:gYear">
				<xs:annotation>
					<xs:documentation>Sünniaasta</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="korgus" type="mets:korgusType">
				<xs:annotation>
					<xs:documentation>Kohustuslik. Kõrgus meetrites</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="diameeter" type="mets:diameeterType">
				<xs:annotation>
					<xs:documentation>Sentimeetrites</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="rinnaspindala" type="mets:rpindalaType">
				<xs:annotation>
					<xs:documentation>Rinnaspindala</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="tagavara" type="mets:tagavaraType">
				<xs:annotation>
					<xs:documentation>Tagavara</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="arv" type="mets:puudeArvType">
				<xs:annotation>
					<xs:documentation>Puude arv</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="enamus" type="mets:tunnusType">
				<xs:annotation>
					<xs:documentation>Peapuuliigi tunnus. Lubatud väärtused 1 või 0</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="eraldisToo">
		<xs:sequence>
			<xs:element name="too" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Kohustuslik. Töö liik.Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 17</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="jarjekord" type="mets:tunnusType">
				<xs:annotation>
					<xs:documentation>Järjekord. Võimalikud väärtused 0, 1, 2, 3, 8, 9</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="rRinne" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Raiutava puuliigi rinne. Võib olla täidetud, kui kavandatud töö on raie.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="rPuuliik" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Raiutav puuliik. Peab ühtima puuliigiga tabelis element. Võib olla täidetud, kui kavandatud töö on raie.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="rVanus" type="mets:vanusType">
				<xs:annotation>
					<xs:documentation>Raiutava puuliigi vanus. Võib olla täidetud, kui kavandatud töö on raie.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="rprotsent" type="mets:protsentType">
				<xs:annotation>
					<xs:documentation>Väljaraie protsent. Väärtus 0..100. Võib olla täidetud, kui kavandatud töö on raie.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="uPuuliik" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Uuendatav puuliik. Väärtus peab leiduma klassifikaatoris.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="tooAasta" type="xs:gYear">
				<xs:annotation>
					<xs:documentation>Töö aasta</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="eraldisKahjustus">
		<xs:sequence>
			<xs:element minOccurs="0" name="kPuuliik" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Kahjustatud puuliik. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 9</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kVanus" type="mets:vanusType">
				<xs:annotation>
					<xs:documentation>Kahjustatud puuliigi vanus. Vanus peab ühtima puuliigi vanusega tabelis element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="1" name="kPohjus" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Kahjustuse põhjus. Väärtus peab leiduma klassifikaatoris. MK juhendi lisa 16</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kOsakaal" type="mets:protsentType">
				<xs:annotation>
					<xs:documentation>Kahjustuse osakaal</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="kRinne" type="mets:koodType">
				<xs:annotation>
					<xs:documentation>Rinne. Väärtus peab leiduma klassifikaatoris</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>

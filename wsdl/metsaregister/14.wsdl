            <xs:element name="MsgType" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Väljasaadetud sõnumi liik: "sendDocumentStatus", "transactionStatement", "accountStatement"</xs:documentation>
                </xs:annotation>
